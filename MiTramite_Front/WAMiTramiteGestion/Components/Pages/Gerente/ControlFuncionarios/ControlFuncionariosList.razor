@using MiTramite_Shared.DTOs.FuncionarioDTOs
@inject Services.IFuncionarioService FuncionarioService
@rendermode InteractiveWebAssembly

<div class="container-fluid mt-4">
    <!-- Buscador y Filtros -->
    <div class="row mb-4">
        <div class="col-lg-4 mb-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control border-0 shadow-sm"
                    placeholder="Buscar por nombre, apellido o correo..." @bind="textoBusqueda" @bind:event="oninput" />
            </div>
        </div>

        <div class="col-lg-3 mb-3">
            <select class="form-select shadow-sm border-0" @bind="campoOrdenamiento">
                <option value="nombres">Ordenar por Nombre</option>
                <option value="apellido">Ordenar por Apellido</option>
                <option value="correo">Ordenar por Correo</option>
                <option value="codigo">Ordenar por Código</option>
            </select>
        </div>

        <div class="col-lg-2 mb-3">
            <select class="form-select shadow-sm border-0" @bind="ordenAscendente">
                <option value="true">Ascendente</option>
                <option value="false">Descendente</option>
            </select>
        </div>

        <div class="col-lg-3 text-end">
            <button class="btn btn-primary shadow-sm" @onclick="AbrirFormularioAgregar">
                <i class="bi bi-plus-circle me-2"></i>Agregar Funcionario
            </button>
        </div>
    </div>

    <!-- Tabla de Funcionarios -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light border-bottom-2">
                <tr>
                    <th class="fw-600">Código</th>
                    <th class="fw-600">Nombre</th>
                    <th class="fw-600">Apellido Paterno</th>
                    <th class="fw-600">Correo</th>
                    <th class="fw-600 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (funcionariosFiltrados != null && funcionariosFiltrados.Count > 0)
                {
                    @foreach (var funcionario in funcionariosFiltrados)
                    {
                        <tr class="border-bottom">
                            <td>
                                <span class="badge bg-light text-dark">@funcionario.CodigoFuncionario</span>
                            </td>
                            <td>@funcionario.Nombres</td>
                            <td>@funcionario.ApellidoPaterno</td>
                            <td>
                                <small class="text-muted">@funcionario.Correo</small>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-2" title="Ver Perfil"
                                    @onclick="() => AbrirFormularioVer(funcionario.IdFuncionario)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <p class="text-muted mb-0">No se encontraron funcionarios</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Información de Resultados -->
    @if (funcionariosFiltrados != null && funcionariosFiltrados.Count > 0)
    {
        <div class="mt-3 text-muted small">
            <p>Mostrando @funcionariosFiltrados.Count funcionario(s)</p>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .fw-600 {
        font-weight: 600;
        color: #003d7a;
    }

    .border-bottom-2 {
        border-bottom: 2px solid #dee2e6 !important;
    }

    .input-group .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    .btn-outline-primary:hover {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }
</style>

@code {
    private List<FuncionarioRegistroDTO>? todosFuncionarios;
    private List<FuncionarioRegistroDTO>? funcionariosFiltrados = new();

    private string textoBusqueda = string.Empty;
    private string campoOrdenamiento = "nombres";
    private bool ordenAscendente = true;

    [Parameter]
    public EventCallback<long> OnVerFuncionario { get; set; }

    [Parameter]
    public EventCallback OnAgregar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarFuncionarios();
    }

    public async Task CargarFuncionarios()
    {
        try
        {
            // Aquí se llamará al servicio para obtener los funcionarios
            todosFuncionarios = await FuncionarioService.ObtenerTodosLosFuncionarios();
            ActualizarFiltros();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar funcionarios: {ex.Message}");
        }
    }

    private void ActualizarFiltros()
    {
        if (todosFuncionarios == null) return;

        // Filtrar por búsqueda
        var filtrados = todosFuncionarios.Where(f =>
        string.IsNullOrEmpty(textoBusqueda) ||
        f.Nombres?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) == true ||
        f.ApellidoPaterno?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) == true ||
        f.Correo?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) == true
        ).ToList();

        // Ordenar
        filtrados = campoOrdenamiento switch
        {
            "apellido" => ordenAscendente
            ? filtrados.OrderBy(f => f.ApellidoPaterno).ToList()
            : filtrados.OrderByDescending(f => f.ApellidoPaterno).ToList(),
            "correo" => ordenAscendente
            ? filtrados.OrderBy(f => f.Correo).ToList()
            : filtrados.OrderByDescending(f => f.Correo).ToList(),
            "codigo" => ordenAscendente
            ? filtrados.OrderBy(f => f.CodigoFuncionario).ToList()
            : filtrados.OrderByDescending(f => f.CodigoFuncionario).ToList(),
            _ => ordenAscendente
            ? filtrados.OrderBy(f => f.Nombres).ToList()
            : filtrados.OrderByDescending(f => f.Nombres).ToList(),
        };

        funcionariosFiltrados = filtrados;
    }

    private async Task AbrirFormularioAgregar()
    {
        await OnAgregar.InvokeAsync();
    }

    private async Task AbrirFormularioVer(long idFuncionario)
    {
        await OnVerFuncionario.InvokeAsync(idFuncionario);
    }
}