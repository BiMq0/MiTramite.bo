@page "/gerente/gestion-tramites/{idSolicitudTramite:long}"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Detalle de Trámite</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4 mt-3">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-clipboard-check me-2"></i>Detalle de Trámite
            </h2>
            <p class="text-muted mb-0">Información detallada del trámite seleccionado</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="VolverATramites">
            <i class="bi bi-arrow-left me-2"></i>Volver a trámites
        </button>
    </div>

    @if (tramiteDetalle == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando detalles del trámite...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap">
                    <h5 class="card-title mb-0">Información General</h5>
                    <span class="badge fw-semibold px-3 py-2 mt-3 mt-md-0"
                        style="@GetEstadoBadgeStyle(tramiteDetalle.Estado)">
                        Estado: @tramiteDetalle.Estado
                    </span>
                </div>
                <hr />
                <div class="row gy-3">
                    <div class="col-md-4">
                        <p class="text-muted mb-1">Tipo de Trámite</p>
                        <p class="fw-semibold mb-0">@tramiteDetalle.NombreTipoTramite</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1">Fecha de Solicitud</p>
                        <p class="fw-semibold mb-0">@tramiteDetalle.FechaSolicitud.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1">Fecha Estimada de Entrega</p>
                        <p class="fw-semibold mb-0">@tramiteDetalle.FechaEstimadaEntrega.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1">Reasignado</p>
                        <p class="fw-semibold mb-0">@tramiteDetalle.Reassigned</p>
                    </div>
                    <div class="col-md-8">
                        <p class="text-muted mb-1">Funcionario Asignado</p>
                        <p class="fw-semibold mb-0">@tramiteDetalle.NombreCompletoFuncionarioAsignado</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(tramiteDetalle.MotivoRechazo))
                    {
                        <div class="col-12">
                            <div class="alert alert-danger d-flex align-items-start gap-3 mb-0">
                                <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                                <div>
                                    <p class="text-muted mb-1">Motivo del Rechazo</p>
                                    <p class="fw-semibold mb-0">@tramiteDetalle.MotivoRechazo</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Datos del Rentista</h5>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary"
                                style="width: 48px; height: 48px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Nombre Completo</p>
                                <p class="fw-semibold mb-0">@tramiteDetalle.NombreCompletoRentista</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary"
                                style="width: 48px; height: 48px;">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Correo</p>
                                <a class="fw-semibold mb-0"
                                    href="mailto:@tramiteDetalle.CorreoRentista">@tramiteDetalle.CorreoRentista</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Datos del Funcionario</h5>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success"
                                style="width: 48px; height: 48px;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Nombre Completo</p>
                                <p class="fw-semibold mb-0">@tramiteDetalle.NombreCompletoFuncionarioAsignado</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success"
                                style="width: 48px; height: 48px;">
                                <i class="bi bi-envelope-at"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Correo</p>
                                <a class="fw-semibold mb-0"
                                    href="mailto:@tramiteDetalle.CorreoFuncionarioAsignado">@tramiteDetalle.CorreoFuncionarioAsignado</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long idSolicitudTramite { get; set; }

    private SolicitudTramiteRegistroDTO? tramiteDetalle;
    private const string EstadoFallbackHex = "#6C757D";

    protected override async Task OnInitializedAsync()
    {
        tramiteDetalle = await TramiteService.ObtenerTramitePorIdAsync(idSolicitudTramite);
    }

    private void VolverATramites()
    {
        NavigationManager.NavigateTo("/gerente/tramites");
    }

    private string GetEstadoBadgeStyle(string estado)
    {
        var hex = GetEstadoHex(estado);
        return $"background-color: {hex}; color: #fff;";
    }

    private string GetEstadoHex(string estado)
    {
        if (!string.IsNullOrWhiteSpace(estado))
        {
            var normalized = estado.Replace(" ", string.Empty);
            if (Enum.TryParse<TramiteEstados>(normalized, true, out var parsed))
            {
                return TramiteEstadosHex.HexFor(parsed);
            }
        }

        return EstadoFallbackHex;
    }
}