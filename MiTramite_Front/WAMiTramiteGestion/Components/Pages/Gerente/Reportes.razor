@page "/gerente/reportes"
@using MiTramite_Front.WAMiTramiteGestion.Services.Reporte
@using MiTramite_Shared.DTOs.Reportes
@inject IJSRuntime JSRuntime
@inject IReporteService ReporteService
@rendermode InteractiveServer

<div class="container-fluid px-4 animate-fadein">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">📊 Reportes Generales</h2>
            <p class="text-muted mb-0">Análisis estadístico del sistema</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="ImprimirReporte">
            <i class="bi bi-printer me-2"></i>Descargar PDF / Imprimir
        </button>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4 bg-light d-print-none">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Año</label>
                    <select class="form-select" @bind="selectedYear">
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="LoadData">
                        <i class="bi bi-filter me-1"></i>Aplicar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Chart 1: Trámites por Mes -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0">Trámites Realizados (Por Mes)</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartTramites"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2: Rentistas por Edad -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0">Rentistas Registrados por Rango de Edad</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartRentistas"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 3: Estado de Trámites -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0">Estado de Trámites</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartEstados"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 4: Incumplimientos -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0">Incumplimientos por Funcionario (Top 5)</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartIncumplimientos"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let chartTramitesInstance = null;
    let chartRentistasInstance = null;
    let chartEstadosInstance = null;
    let chartIncumplimientosInstance = null;

    window.renderCharts = (tramitesData, rentistasData, estadosData, incumplimientosData) => {
        // Destroy existing charts if they exist
        if (chartTramitesInstance) chartTramitesInstance.destroy();
        if (chartRentistasInstance) chartRentistasInstance.destroy();
        if (chartEstadosInstance) chartEstadosInstance.destroy();
        if (chartIncumplimientosInstance) chartIncumplimientosInstance.destroy();

        // Chart 1: Trámites
        const tramitesLabels = tramitesData.map(d => d.mes);
        const tramitesValues = tramitesData.map(d => d.cantidad);

        chartTramitesInstance = new Chart(document.getElementById('chartTramites'), {
            type: 'line',
            data: {
                labels: tramitesLabels,
                datasets: [{
                    label: 'Trámites Completados',
                    data: tramitesValues,
                    borderColor: '#0d6efd',
                    tension: 0.1,
                    fill: true,
                    backgroundColor: 'rgba(13, 110, 253, 0.1)'
                }]
            },
            options: { responsive: true }
        });

        // Chart 2: Rentistas
        const rentistasLabels = rentistasData.map(d => d.rangoEdad);
        const rentistasValues = rentistasData.map(d => d.cantidad);

        chartRentistasInstance = new Chart(document.getElementById('chartRentistas'), {
            type: 'bar',
            data: {
                labels: rentistasLabels,
                datasets: [{
                    label: 'Cantidad de Rentistas',
                    data: rentistasValues,
                    backgroundColor: '#198754'
                }]
            },
            options: { responsive: true }
        });

        // Chart 3: Estados
        const estadosLabels = estadosData.map(d => d.estado);
        const estadosValues = estadosData.map(d => d.cantidad);

        chartEstadosInstance = new Chart(document.getElementById('chartEstados'), {
            type: 'doughnut',
            data: {
                labels: estadosLabels,
                datasets: [{
                    data: estadosValues,
                    backgroundColor: ['#198754', '#dc3545', '#ffc107', '#0dcaf0', '#6c757d']
                }]
            },
            options: { responsive: true }
        });

        // Chart 4: Incumplimientos
        const incLabels = incumplimientosData.map(d => d.funcionarioNombre);
        const incValues = incumplimientosData.map(d => d.cantidadIncumplimientos);

        chartIncumplimientosInstance = new Chart(document.getElementById('chartIncumplimientos'), {
            type: 'bar',
            data: {
                labels: incLabels,
                datasets: [{
                    label: 'Incumplimientos',
                    data: incValues,
                    backgroundColor: '#dc3545'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true
            }
        });
    };
</script>

@code {
    private int selectedYear = DateTime.Now.Year;
    private ReporteDashboardDTO? dashboardData;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        dashboardData = await ReporteService.GetDashboardDataAsync(selectedYear);
        if (dashboardData != null)
        {
            await JSRuntime.InvokeVoidAsync("renderCharts",
            dashboardData.TramitesPorMes,
            dashboardData.RentistasPorEdad,
            dashboardData.EstadosTramites,
            dashboardData.IncumplimientosTop);
        }
    }

    private async Task ImprimirReporte()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }
}