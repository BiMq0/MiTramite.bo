@page "/gerente/reportes"

<div class="container-fluid px-4 animate-fadein">
    <h2 class="fw-bold text-primary mb-4 mt-3">📊 Reportes Generales</h2>

    <div class="card border-0 shadow p-4">
        <h4 class="fw-bold text-primary mb-3">Resumen de Actividades</h4>
        <p>Visualiza el estado general de trámites y personal activo.</p>

        <div class="row mt-4 text-center">
            <div class="col-md-4">
                <div class="info-card bg-success text-white p-4 rounded shadow-sm">
                    <h5>Trámites Aprobados</h5>
                    <h3>105</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card bg-warning text-dark p-4 rounded shadow-sm">
                    <h5>En Proceso</h5>
                    <h3>22</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card bg-danger text-white p-4 rounded shadow-sm">
                    <h5>Rechazados</h5>
                    <h3>8</h3>
                </div>
            </div>
        </div>
    </div>
</div>