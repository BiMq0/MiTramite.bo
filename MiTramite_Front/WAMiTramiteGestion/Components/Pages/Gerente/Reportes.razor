@page "/gerente/reportes"
@using MiTramite_Front.WAMiTramiteGestion.Services.Reporte
@using MiTramite_Front.WAMiTramiteGestion.Services.Pdf
@using MiTramite_Shared.DTOs.Reportes
@inject IJSRuntime JSRuntime
@inject IReporteService ReporteService
@inject IPdfService PdfService
@rendermode InteractiveServer

<div class="container-fluid px-4 animate-fadein overflow-auto" style="max-height: calc(100vh - 120px);">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-bar-chart-fill me-2"></i>Reportes Generales</h2>
            <p class="text-muted mb-0">Análisis estadístico del sistema</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="DescargarReporte">
            <i class="bi bi-file-earmark-pdf me-2"></i>Descargar Informe PDF
        </button>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4 bg-light d-print-none">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Año</label>
                    <select class="form-select" @bind="selectedYear">
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="LoadData"
                        style="background-color: #003366; border-color: #003366;">
                        <i class="bi bi-filter me-1"></i>Aplicar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0" style="color: #003366 !important;">Trámites Realizados (Por
                        Mes)</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartTramites"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0" style="color: #003366 !important;">Rentistas Registrados por
                        Rango de Edad</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartRentistas"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 3: Estado de Trámites -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0" style="color: #003366 !important;">Estado de Trámites</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartEstados"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-secondary mb-0" style="color: #003366 !important;">Incumplimientos por
                        Funcionario (Top 5)</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartIncumplimientos"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let chartTramitesInstance = null;
    let chartRentistasInstance = null;
    let chartEstadosInstance = null;
    let chartIncumplimientosInstance = null;

    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? '';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    }

    window.renderCharts = (tramitesData, rentistasData, estadosData, incumplimientosData) => {
        // Destroy existing charts if they exist
        if (chartTramitesInstance) chartTramitesInstance.destroy();
        if (chartRentistasInstance) chartRentistasInstance.destroy();
        if (chartEstadosInstance) chartEstadosInstance.destroy();
        if (chartIncumplimientosInstance) chartIncumplimientosInstance.destroy();

        // Chart 1: Trámites
        const tramitesLabels = tramitesData.map(d => d.mes);
        const tramitesValues = tramitesData.map(d => d.cantidad);

        chartTramitesInstance = new Chart(document.getElementById('chartTramites'), {
            type: 'line',
            data: {
                labels: tramitesLabels,
                datasets: [{
                    label: 'Trámites Completados',
                    data: tramitesValues,
                    borderColor: '#003366',
                    tension: 0.1,
                    fill: true,
                    backgroundColor: 'rgba(0, 51, 102, 0.1)'
                }]
            },
            options: { responsive: true }
        });

        // Chart 2: Rentistas
        const rentistasLabels = rentistasData.map(d => d.rangoEdad);
        const rentistasValues = rentistasData.map(d => d.cantidad);

        chartRentistasInstance = new Chart(document.getElementById('chartRentistas'), {
            type: 'bar',
            data: {
                labels: rentistasLabels,
                datasets: [{
                    label: 'Cantidad de Rentistas',
                    data: rentistasValues,
                    backgroundColor: '#0056b3'
                }]
            },
            options: { responsive: true }
        });

        const estadosLabels = estadosData.map(d => d.estado);
        const estadosValues = estadosData.map(d => d.cantidad);

        chartEstadosInstance = new Chart(document.getElementById('chartEstados'), {
            type: 'doughnut',
            data: {
                labels: estadosLabels,
                datasets: [{
                    data: estadosValues,
                    backgroundColor: ['#003366', '#004080', '#0056b3', '#337ab7', '#6699cc']
                }]
            },
            options: { responsive: true }
        });

        // Chart 4: Incumplimientos
        const incLabels = incumplimientosData.map(d => d.nombreFuncionario);
        const incValues = incumplimientosData.map(d => d.cantidad);

        chartIncumplimientosInstance = new Chart(document.getElementById('chartIncumplimientos'), {
            type: 'bar',
            data: {
                labels: incLabels,
                datasets: [{
                    label: 'Incumplimientos',
                    data: incValues,
                    backgroundColor: '#003366' // Gestora Dark Blue
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true
            }
        });
    };
</script>

@code {
    private int selectedYear = DateTime.Now.Year;
    private ReporteDashboardDTO? dashboardData;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        dashboardData = await ReporteService.GetDashboardDataAsync(selectedYear);
        if (dashboardData != null)
        {
            await JSRuntime.InvokeVoidAsync("renderCharts",
            dashboardData.TramitesPorMes,
            dashboardData.RentistasPorEdad,
            dashboardData.EstadosTramites,
            dashboardData.IncumplimientosTop);
        }
    }

    private async Task DescargarReporte()
    {
        if (dashboardData == null) return;

        var pdfBytes = PdfService.GenerateReport(dashboardData, selectedYear);
        using var stream = new MemoryStream(pdfBytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"Reporte_Gestion_{selectedYear}.pdf", streamRef);
    }
}