@page "/gerente/tramites"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@rendermode InteractiveServer

<PageTitle>Trámites Generales</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-clipboard-data me-2"></i>Trámites Generales
        </h2>
        <p class="text-muted">Vista general de todos los trámites en el sistema</p>
    </div>

    @if (tramites == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando trámites...</p>
        </div>
    }
    else if (!tramites.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No hay trámites registrados en el sistema.
        </div>
    }
    else
    {
        <!-- Estadísticas rápidas -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Total Trámites</h6>
                                <h3 class="mb-0">@tramites.Count</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded">
                                <i class="bi bi-file-earmark-text text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Pendientes</h6>
                                <h3 class="mb-0">@tramites.Count(t => t.Estado == TramiteEstados.Pendiente.ToString())</h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded">
                                <i class="bi bi-hourglass-split text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Completados</h6>
                                <h3 class="mb-0">@tramites.Count(t => t.Estado == TramiteEstados.Completado.ToString())</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded">
                                <i class="bi bi-check-circle text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Rechazados</h6>
                                <h3 class="mb-0">@tramites.Count(t => t.Estado == TramiteEstados.Rechazado.ToString())</h3>
                            </div>
                            <div class="bg-danger bg-opacity-10 p-3 rounded">
                                <i class="bi bi-x-circle text-danger fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de trámites -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light border-bottom py-3">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="bi bi-list-ul me-2"></i>Listado Completo de Trámites
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 8%">ID</th>
                                <th style="width: 18%">Tipo de Trámite</th>
                                <th style="width: 18%">Rentista</th>
                                <th style="width: 18%">Funcionario</th>
                                <th style="width: 13%">Fecha Solicitud</th>
                                <th style="width: 13%">Fecha Estimada</th>
                                <th style="width: 12%">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tramite in tramites.OrderByDescending(t => t.FechaSolicitud))
                            {
                                <tr>
                                    <td><strong>#@tramite.IdSolicitudTramite</strong></td>
                                    <td>@tramite.NombreTipoTramite</td>
                                    <td>@tramite.NombreRentista</td>
                                    <td>@tramite.NombreFuncionarioAsignado</td>
                                    <td>@tramite.FechaSolicitud.ToShortDateString()</td>
                                    <td>@tramite.FechaEstimadaEntrega.ToShortDateString()</td>
                                    <td>
                                        <span class="badge @GetEstadoBadgeClass(tramite.Estado)">
                                            @tramite.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SolicitudTramiteRegistroDTO>? tramites;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramites = await TramiteService.ObtenerTodosLosTramitesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            tramites = new List<SolicitudTramiteRegistroDTO>();
        }
    }

    private string GetEstadoBadgeClass(string estado)
    {
        if (estado == TramiteEstados.Pendiente.ToString()) return "bg-warning text-dark";
        if (estado == TramiteEstados.EnProceso.ToString()) return "bg-info text-dark";
        if (estado == TramiteEstados.Completado.ToString()) return "bg-success";
        if (estado == TramiteEstados.Rechazado.ToString()) return "bg-danger";
        return "bg-secondary";
    }
}