@page "/gerente/incumplimientos"
@using MiTramite_Shared.DTOs.Incumplimiento
@using WAMiTramiteGestion.Services.Incumplimiento
@inject IIncumplimientoService IncumplimientoService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Gestión de Incumplimientos</PageTitle>

<div class="container-fluid px-4 animate-fadein overflow-auto" style="max-height: calc(100vh - 120px);">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Incumplimientos
            </h2>
            <p class="text-muted mb-0">Registro de reasignaciones por incumplimiento de plazos</p>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Buscar Rentista</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i
                                class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Nombre del rentista..."
                            @bind="filtroRentista" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Funcionario Original</label>
                    <input type="text" class="form-control" placeholder="Nombre..." @bind="filtroFuncionarioOriginal"
                        @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Funcionario Reasignado</label>
                    <input type="text" class="form-control" placeholder="Nombre..." @bind="filtroFuncionarioReasignado"
                        @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (incumplimientos == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando registros...</p>
        </div>
    }
    else
    {
        var listaFiltrada = GetFiltrados();

        @if (!listaFiltrada.Any())
        {
            <div class="alert alert-info shadow-sm">
                <i class="bi bi-info-circle me-2"></i>No se encontraron registros de incumplimiento con los filtros actuales.
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">ID Trámite</th>
                                    <th>Rentista Solicitante</th>
                                    <th>Funcionario Original</th>
                                    <th>Funcionario Reasignado</th>
                                    <th>Fecha Reasignación</th>
                                    <th class="text-end pe-4">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in listaFiltrada)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">#@item.IdSolicitudTramite</td>
                                        <td>@item.NombreRentista</td>
                                        <td>
                                            <span class="text-danger">@item.NombreFuncionarioOriginal</span>
                                        </td>
                                        <td>
                                            <span class="text-success">@item.NombreFuncionarioReasignado</span>
                                        </td>
                                        <td>@item.FechaIncumplimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => VerDetalle(item.IdSolicitudTramite)">
                                                <i class="bi bi-eye me-1"></i> Ver Detalle
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 py-3">
                    <small class="text-muted">Mostrando @listaFiltrada.Count registros</small>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<IncumplimientoRegistroDTO>? incumplimientos;

    // Filtros
    private string filtroRentista = "";
    private string filtroFuncionarioOriginal = "";
    private string filtroFuncionarioReasignado = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            incumplimientos = await IncumplimientoService.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            incumplimientos = new List<IncumplimientoRegistroDTO>();
        }
    }

    private List<IncumplimientoRegistroDTO> GetFiltrados()
    {
        if (incumplimientos == null) return new List<IncumplimientoRegistroDTO>();

        var query = incumplimientos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroRentista))
            query = query.Where(x => x.NombreRentista.Contains(filtroRentista, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filtroFuncionarioOriginal))
            query = query.Where(x => x.NombreFuncionarioOriginal.Contains(filtroFuncionarioOriginal,
            StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filtroFuncionarioReasignado))
            query = query.Where(x => x.NombreFuncionarioReasignado.Contains(filtroFuncionarioReasignado,
            StringComparison.OrdinalIgnoreCase));

        return query.ToList();
    }

    private void LimpiarFiltros()
    {
        filtroRentista = "";
        filtroFuncionarioOriginal = "";
        filtroFuncionarioReasignado = "";
    }

    private void VerDetalle(long id)
    {
        NavigationManager.NavigateTo($"/gerente/incumplimientos/{id}");
    }
}