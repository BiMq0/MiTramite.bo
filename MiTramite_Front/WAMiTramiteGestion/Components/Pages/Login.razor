@page "/login"
@using MiTramite_Shared.DTOs.FuncionarioDTOs
@using Microsoft.AspNetCore.Components.Forms
@inject Services.IFuncionarioService FuncionarioService
@inject NavigationManager NavigationManager
@inject Services.VerificationService.ITokenVerificationService TokenVerificationService
@inject Handlers.LoginStateService LoginStateService
@rendermode InteractiveServer


<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 60px);
        background: linear-gradient(135deg, #003d7a 0%, #0052a3 50%, #1a5fb5 100%);
    }

    .login-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 0.5rem;
        padding: 1.75rem 1.25rem;
        box-shadow: 0 10px 30px rgba(0, 30, 60, 0.2);
        width: 90%;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: slideUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .login-logo-container {
        margin-bottom: 1rem;
        padding: 0.6rem;
        background: white;
        border-radius: 0.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .login-logo-container img {
        height: 45px;
    }

    .login-title {
        text-align: center;
        font-weight: 700;
        color: #003d7a;
        margin-bottom: 1.4rem;
        font-size: 1.35rem;
        letter-spacing: -0.5px;
    }

    .form-group {
        width: 100%;
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 0.4rem;
        color: #003d7a;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control {
        border-radius: 0.4rem;
        padding: 0.7rem 0.9rem;
        font-size: 0.9rem;
        border: 1.5px solid #e0e8f0;
        background: #f8fafb;
        transition: all 0.3s ease;
        color: #333;
    }

    .form-control:focus {
        outline: none;
        border-color: #0052a3;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(0, 82, 163, 0.1);
    }

    .form-control::placeholder {
        color: #999;
    }

    .password-group {
        position: relative;
        width: 100%;
    }

    .password-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #0052a3;
        cursor: pointer;
        padding: 0.3rem 0.5rem;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

    .password-toggle:hover {
        color: #003d7a;
        transform: translateY(-50%) scale(1.1);
    }

    .btn-login {
        border-radius: 0.4rem;
        font-weight: 700;
        padding: 0.8rem;
        background: linear-gradient(135deg, #003d7a 0%, #0052a3 100%);
        border: none;
        width: 100%;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        color: white;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        margin-top: 0.5rem;
    }

    .btn-login:hover {
        background: linear-gradient(135deg, #001f3f 0%, #003d7a 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 52, 122, 0.3);
    }

    .btn-login:active {
        transform: translateY(0);
        box-shadow: 0 4px 10px rgba(0, 52, 122, 0.2);
    }

    .btn-login:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }

    .alert {
        margin-top: 1.5rem;
        padding: 1rem;
        border-radius: 0.4rem;
        font-size: 0.9rem;
    }

    .alert-danger {
        background: #ffe8e8;
        border: 1px solid #ff6b6b;
        color: #c92a2a;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 480px) {
        .login-card {
            padding: 1.5rem 1.25rem;
            margin: 1rem;
            max-width: 100%;
        }

        .login-title {
            font-size: 1.3rem;
        }

        .login-container {
            padding: 1rem;
        }
    }
</style>

<div class="login-container">
    <div class="login-card">
        <div class="login-logo-container">
            <img src="https://www.gestora.bo/img/logos/logoslogan.png" alt="Logo Gestora" class="login-logo" />
        </div>

        <h3 class="login-title">Iniciar Sesión</h3>

        <EditForm Model="funcionarioLogin" OnValidSubmit="HandleLogin" FormName="loginForm">
            <ValidationSummary />

            <div class="form-group">
                <label class="form-label">Código de Funcionario</label>
                <InputText class="form-control" @bind-Value="funcionarioLogin.CodigoFuncionario"
                    placeholder="Ingrese su código" />
                <ValidationMessage For="@(() => funcionarioLogin.CodigoFuncionario)" />
            </div>

            <div class="form-group">
                <label class="form-label">Correo electrónico</label>
                <InputText type="email" class="form-control" @bind-Value="funcionarioLogin.Correo"
                    placeholder="ejemplo@correo.com" />
                <ValidationMessage For="@(() => funcionarioLogin.Correo)" />
            </div>

            <div class="form-group">
                <label class="form-label">Contraseña</label>
                <div class="password-group">
                    <InputText type="@(mostrarContraseña ? "text" : "password")" class="form-control"
                        @bind-Value="funcionarioLogin.Password" placeholder="********" style="padding-right: 2.5rem;" />
                    <button type="button" class="password-toggle" @onclick="AlternarVisibilidadContraseña"
                        tabindex="-1">
                        <i class="bi @(mostrarContraseña ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => funcionarioLogin.Password)" />
            </div>

            <div class="d-grid mt-2">
                <button type="submit" class="btn btn-login text-white">
                    Entrar
                </button>
            </div>
        </EditForm>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @mensajeError
            </div>
        }
    </div>
</div>


@code {
    private FuncionarioLoginDTO funcionarioLogin = new();
    private string mensajeError = string.Empty;
    private bool mostrarContraseña = false;

    protected override async Task OnInitializedAsync()
    {
        if (await TokenVerificationService.TokenExistsOrIsValidAsync())
        {
            var rol = FuncionarioService.FuncionarioActual?.Rol;
            if (!string.IsNullOrEmpty(rol))
            {
                RedireccionarPorRol(rol);
            }
            await base.OnInitializedAsync();
        }
    }
    private void AlternarVisibilidadContraseña()
    {
        mostrarContraseña = !mostrarContraseña;
    }

    private async Task HandleLogin()
    {
        try
        {
            mensajeError = string.Empty;
            var resultado = await FuncionarioService.IniciarSesion(funcionarioLogin);

            if (resultado != null)
            {
                LoginStateService.NotifyLoginSuccess(resultado);
                RedireccionarPorRol(resultado.Rol!);
            }
            else
            {
                mensajeError = "Credenciales inválidas. Por favor, verifique sus datos.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al iniciar sesión: {ex.Message}";
        }
    }

    private void RedireccionarPorRol(string rol)
    {
        NavigationManager.NavigateTo($"/{rol.ToLower()}/inicio");
    }
}