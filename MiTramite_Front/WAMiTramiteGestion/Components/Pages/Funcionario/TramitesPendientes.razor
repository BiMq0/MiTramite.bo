@page "/funcionario/tramites-pendientes"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject Services.IFuncionarioService FuncionarioService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Trámites Pendientes</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-hourglass-split me-2"></i>Trámites Pendientes
        </h2>
        <p class="text-muted">Revisa y procesa los trámites asignados</p>
    </div>

    @if (tramites == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando trámites...</p>
        </div>
    }
    else
    {
        var tramitesPendientes = tramites
        .Where(t => t.Estado == TramiteEstados.Pendiente.ToString() || t.Estado == TramiteEstados.EnProceso.ToString())
        .ToList();

        @if (!tramitesPendientes.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No hay trámites pendientes en este momento.
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-bottom py-3">
                    <h5 class="fw-bold text-primary mb-0">
                        <i class="bi bi-list-check me-2"></i>Listado de Trámites Pendientes (@tramitesPendientes.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%">ID Trámite</th>
                                    <th style="width: 20%">Tipo de Trámite</th>
                                    <th style="width: 20%">Nombre Rentista</th>
                                    <th style="width: 15%">Fecha Solicitud</th>
                                    <th style="width: 15%">Fecha Estimada</th>
                                    <th style="width: 10%">Estado</th>
                                    <th style="width: 10%">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tramite in tramitesPendientes)
                                {
                                    <tr>
                                        <td><strong># @tramite.IdSolicitudTramite</strong></td>
                                        <td>@tramite.NombreTipoTramite</td>
                                        <td>@tramite.NombreCompletoRentista</td>
                                        <td>@tramite.FechaSolicitud.ToShortDateString()</td>
                                        <td>@tramite.FechaEstimadaEntrega.ToShortDateString()</td>
                                        <td>
                                            <span class="badge @GetEstadoBadgeClass(tramite.Estado)">
                                                @tramite.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => RevisarTramite(tramite.IdSolicitudTramite)">
                                                <i class="bi bi-eye me-1"></i>Revisar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

</div>

<style>
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #495057;
        border-bottom: 2px solid #dee2e6;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn-outline-primary:hover {
        background-color: #2c5282;
        border-color: #2c5282;
        color: white;
    }
</style>

@code {
    private List<SolicitudTramiteRegistroDTO>? tramites;
    [Parameter]
    public long idFuncionario { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var funcionarioActual = await FuncionarioService.ObtenerFuncionarioActualAsync();
            if (funcionarioActual == null)
            {
                NavigationManager.NavigateTo("/login");
                tramites = new List<SolicitudTramiteRegistroDTO>();
                return;
            }

            idFuncionario = funcionarioActual.IdFuncionario;
            tramites = await TramiteService.ObtenerTramitesPorFuncionarioAsync(idFuncionario);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar trámites: {ex.Message}");
            tramites = new List<SolicitudTramiteRegistroDTO>();
        }
    }

    private void RevisarTramite(long idSolicitudTramite)
    {
        NavigationManager.NavigateTo($"/funcionario/tramites-pendientes/revisar/{idSolicitudTramite}");
    }

    private string GetEstadoBadgeClass(string estado)
    {
        if (estado == TramiteEstados.Pendiente.ToString()) return "bg-warning text-dark";
        if (estado == TramiteEstados.EnProceso.ToString()) return "bg-info text-dark";
        return "bg-secondary";
    }
}