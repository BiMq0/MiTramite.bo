                            <td>21/11/2025</td>
                            <td>28/11/2025</td>
                            <td><span class="badge" style="background-color: #5CB85C; color: white;">Completado</span>
                            </td>
                            <td><span class="badge bg-secondary">No</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => IrAVerDetalle(3)">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </button>
                            </td>
                        </tr>
                        <!-- Fila 3 - Rechazado -->
                        <tr>
                            <td><strong>#TRX-2025-008</strong></td>
                            <td>Renta Dignidad</td>
                            <td>Alejandra Morales</td>
                            <td>18/11/2025</td>
                            <td>25/11/2025</td>
                            <td><span class="badge" style="background-color: #D9534F; color: white;">Rechazado</span>
                            </td>
                            <td><span class="badge bg-danger">Sí</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => IrAVerDetalle(8)">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </button>
                            </td>
                        </tr>
                        <!-- Fila 4 - Completado -->
                        <tr>
                            <td><strong>#TRX-2025-009</strong></td>
                            <td>Cambio de Domicilio</td>
                            <td>Gustavo López Pérez</td>
                            <td>17/11/2025</td>
                            <td>24/11/2025</td>
                            <td><span class="badge" style="background-color: #5CB85C; color: white;">Completado</span>
                            </td>
                            <td><span class="badge bg-secondary">No</span></td>
