                            <td>María López García</td>
                            <td>22/11/2025</td>
                            <td>29/11/2025</td>
                            <td><span class="badge" style="background-color: #5CB85C; color: white;">Completado</span>
                            </td>
                            <td><span class="badge bg-secondary">No</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => IrAVerDetalle(2)">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </button>
                            </td>
                        </tr>
                        <!-- Fila 2 - Completado -->
                        <tr>
                            <td><strong>#TRX-2025-003</strong></td>
