@page "/funcionario/historial-tramites"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject Services.IFuncionarioService FuncionarioService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Historial de Trámites</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-clock-history me-2"></i>Historial de Trámites
        </h2>
        <p class="text-muted">Consulta todos los trámites que has procesado</p>
    </div>

    @if (tramites == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visualmente-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando historial...</p>
        </div>
    }
    else
    {
        var tramitesHistorial = tramites
        .Where(t => t.Estado == TramiteEstados.Completado.ToString() || t.Estado == TramiteEstados.Rechazado.ToString())
        .ToList();

        @if (!tramitesHistorial.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No hay trámites en el historial.
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-bottom py-3">
                    <h5 class="fw-bold text-primary mb-0">
                        <i class="bi bi-clock-history me-2"></i>Listado de Trámites Completados (@tramitesHistorial.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%">ID Trámite</th>
                                    <th style="width: 20%">Tipo de Trámite</th>
                                    <th style="width: 20%">Nombre Rentista</th>
                                    <th style="width: 15%">Fecha Solicitud</th>
                                    <th style="width: 15%">Fecha Estimada</th>
                                    <th style="width: 10%">Estado</th>
                                    <th style="width: 10%">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tramite in tramitesHistorial)
                                {
                                    <tr>
                                        <td><strong>@tramite.IdSolicitudTramite</strong></td>
                                        <td>@tramite.NombreTipoTramite</td>
                                        <td>@tramite.NombreCompletoRentista</td>
                                        <td>@tramite.FechaSolicitud.ToShortDateString()</td>
                                        <td>@tramite.FechaEstimadaEntrega.ToShortDateString()</td>
                                        <td>
                                            <span class="badge @GetEstadoBadgeClass(tramite.Estado)">
                                                @tramite.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => VerDetalle(tramite.IdSolicitudTramite)">
                                                <i class="bi bi-eye me-1"></i>Ver
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<SolicitudTramiteRegistroDTO>? tramites;
    private long idFuncionario = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var funcionarioActual = await FuncionarioService.ObtenerFuncionarioActualAsync();
            if (funcionarioActual == null)
            {
                NavigationManager.NavigateTo("/login");
                tramites = new List<SolicitudTramiteRegistroDTO>();
                return;
            }

            idFuncionario = funcionarioActual.IdFuncionario;
            tramites = await TramiteService.ObtenerTramitesPorFuncionarioAsync(idFuncionario);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            tramites = new List<SolicitudTramiteRegistroDTO>();
        }
    }

    private void VerDetalle(long idTramite)
    {
        NavigationManager.NavigateTo($"/funcionario/historial-tramites/ver-detalles/{idTramite}");
    }

    private string GetEstadoBadgeClass(string estado)
    {
        if (estado == TramiteEstados.Completado.ToString()) return "bg-success";
        if (estado == TramiteEstados.Rechazado.ToString()) return "bg-danger";
        return "bg-secondary";
    }
}