@page "/funcionario/inicio"
@using MiTramite_Shared.DTOs.FuncionarioDTOs
@inject Services.ITramiteService TramiteService

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </h2>
        <p class="text-muted">Resumen de tus trámites y actividades</p>
    </div>

    #region Datos de Ejemplo
    <!-- Cards de resumen -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="card-text opacity-75 mb-0">Pendientes</p>
                            <h3 class="fw-bold mb-0">5</h3>
                        </div>
                        <i class="bi bi-clock-history fs-4 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="card-text opacity-75 mb-0">Completados</p>
                            <h3 class="fw-bold mb-0">28</h3>
                        </div>
                        <i class="bi bi-check-circle fs-4 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="card-text opacity-75 mb-0">Urgentes</p>
                            <h3 class="fw-bold mb-0">2</h3>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-4 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="card-text opacity-75 mb-0">Total Procesados</p>
                            <h3 class="fw-bold mb-0">45</h3>
                        </div>
                        <i class="bi bi-file-earmark-text fs-4 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos Trámites -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light border-bottom py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="bi bi-list-task me-2"></i>Últimos Trámites
                </h5>
                <a href="/funcionario/tramites-pendientes" class="btn btn-sm btn-outline-primary">
                    Ver todos
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <!-- Datos de ejemplo -->
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID Trámite</th>
                            <th>Tipo</th>
                            <th>Rentista</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>#TRX-2025-001</strong></td>
                            <td>Renta Dignidad</td>
                            <td>Juan Carlos Pérez</td>
                            <td>23/11/2025</td>
                            <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                            <td><a href="/funcionario/tramites-pendientes/revisar/1"
                                    class="btn btn-sm btn-outline-primary">Ver</a></td>
                        </tr>
                        <tr>
                            <td><strong>#TRX-2025-002</strong></td>
                            <td>Afiliación</td>
                            <td>María López García</td>
                            <td>22/11/2025</td>
                            <td><span class="badge bg-success">Completado</span></td>
                            <td><a href="/funcionario/historial-tramites/detalles/2"
                                    class="btn btn-sm btn-outline-secondary">Ver</a></td>
                        </tr>
                        <tr>
                            <td><strong>#TRX-2025-003</strong></td>
                            <td>Actualización de Datos</td>
                            <td>Pedro Rodríguez</td>
                            <td>21/11/2025</td>
                            <td><span class="badge bg-success">Completado</span></td>
                            <td><a href="/funcionario/historial-tramites/detalles/3"
                                    class="btn btn-sm btn-outline-secondary">Ver</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    #endregion
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #003d7a 0%, #2c5282 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
    }
</style>

