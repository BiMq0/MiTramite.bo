@page "/funcionario/inicio"

<div class="container-fluid px-4">
    <h2 class="fw-bold text-primary mb-4 mt-3">Panel del Funcionario</h2>

    <div class="card border-0 shadow p-4 animate-fadein">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold text-primary mb-0">📁 Trámites Recientes</h4>
            <button class="btn btn-sm btn-gradient rounded-pill px-3">
                Ver todos
            </button>
        </div>

        <!-- Tabla moderna -->
        <div class="table-wrapper">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tipo de Trámite</th>
                        <th>Nombre del Solicitante</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Afiliación</td>
                        <td>Juan Pérez</td>
                        <td>2025-10-20</td>
                        <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                        <td><button class="btn btn-sm btn-gradient">Revisar</button></td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Renta Dignidad</td>
                        <td>María López</td>
                        <td>2025-10-21</td>
                        <td><span class="badge bg-success">Aprobado</span></td>
                        <td><button class="btn btn-sm btn-secondary">Ver</button></td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Actualización de Datos</td>
                        <td>Pedro Rojas</td>
                        <td>2025-10-22</td>
                        <td><span class="badge bg-danger">Rechazado</span></td>
                        <td><button class="btn btn-sm btn-outline-danger">Detalles</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>