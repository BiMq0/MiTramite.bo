@page "/funcionario/historial-tramites/ver-detalles/{IdSolicitudTramite:long}"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject Services.IFuncionarioService FuncionarioService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Detalles del Trámite - Historial</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="VolverAlHistorial">
            <i class="bi bi-arrow-left me-2"></i>Volver al Historial
        </button>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-file-earmark-text me-2"></i>Detalles del Trámite
        </h2>
        <p class="text-muted">Información completa del trámite procesado</p>
    </div>

    @if (tramite == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando detalles...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-light border-bottom py-3">
                        <h5 class="fw-bold text-primary mb-0">
                            <i class="bi bi-info-circle me-2"></i>Información del Trámite
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row gy-3">
                            <div class="col-sm-6">
                                <p class="text-uppercase text-muted small mb-1">ID Trámite</p>
                                <p class="fs-5 fw-semibold mb-0"># @tramite.IdSolicitudTramite</p>
                            </div>
                            <div class="col-sm-6">
                                <p class="text-uppercase text-muted small mb-1">Tipo de Trámite</p>
                                <p class="fw-semibold mb-0">@tramite.NombreTipoTramite</p>
                            </div>
                            <div class="col-sm-6">
                                <p class="text-uppercase text-muted small mb-1">Fecha de Solicitud</p>
                                <p class="fw-semibold mb-0">@tramite.FechaSolicitud.ToShortDateString()</p>
                            </div>
                            <div class="col-sm-6">
                                <p class="text-uppercase text-muted small mb-1">Fecha Estimada de Entrega</p>
                                <p class="fw-semibold mb-0">@tramite.FechaEstimadaEntrega.ToShortDateString()</p>
                            </div>
                            <div class="col-12">
                                <p class="text-uppercase text-muted small mb-2">Estado</p>
                                <span class="badge fw-semibold rounded-pill" style="@GetEstadoBadgeStyle(tramite.Estado)">
                                    @tramite.Estado
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(tramite.MotivoRechazo))
                        {
                            <div
                                class="alert alert-danger border-0 rounded-3 shadow-sm d-flex align-items-start gap-3 mt-4 mb-0">
                                <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                                <div>
                                    <p class="text-uppercase text-muted small mb-1">Motivo del Rechazo</p>
                                    <p class="fw-semibold mb-0">@tramite.MotivoRechazo</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-light border-bottom py-3">
                        <h5 class="fw-bold text-primary mb-0">
                            <i class="bi bi-person me-2"></i>Información del Rentista
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary"
                                style="width: 54px; height: 54px;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                            <div>
                                <p class="text-uppercase text-muted small mb-1">Nombre Completo</p>
                                <p class="fw-semibold mb-0">@tramite.NombreCompletoRentista</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary"
                                style="width: 54px; height: 54px;">
                                <i class="bi bi-envelope-fill fs-5"></i>
                            </div>
                            <div>
                                <p class="text-uppercase text-muted small mb-1">Correo</p>
                                <a href="mailto:@tramite.CorreoRentista" class="fw-semibold">@tramite.CorreoRentista</a>
                            </div>
                        </div>

                        <hr class="my-4" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <button class="btn btn-outline-secondary" @onclick="VolverAlHistorial">
                    <i class="bi bi-arrow-left me-2"></i>Volver al Historial
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long IdSolicitudTramite { get; set; }

    private SolicitudTramiteRegistroDTO? tramite;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramite = await TramiteService.ObtenerTramitePorIdAsync(IdSolicitudTramite);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void VolverAlHistorial()
    {
        NavigationManager.NavigateTo("/funcionario/historial-tramites/");
    }

    private const string EstadoFallbackHex = "#6C757D";

    private string GetEstadoBadgeStyle(string estado)
    {
        var hex = GetEstadoHex(estado);
        return $"background-color: {hex}; color: #fff; font-size: 0.9rem; padding: 0.5rem 0.75rem;";
    }

    private string GetEstadoHex(string estado)
    {
        if (!string.IsNullOrWhiteSpace(estado))
        {
            var normalized = estado.Replace(" ", string.Empty);
            if (Enum.TryParse<TramiteEstados>(normalized, true, out var parsed))
            {
                return TramiteEstadosHex.HexFor(parsed);
            }
        }

        return EstadoFallbackHex;
    }
}