@page "/funcionario/historial-tramites/ver-detalles/{IdSolicitudTramite:long}"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Detalles del Trámite - Historial</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="VolverAlHistorial">
            <i class="bi bi-arrow-left me-2"></i>Volver al Historial
        </button>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-file-earmark-text me-2"></i>Detalles del Trámite
        </h2>
        <p class="text-muted">Información completa del trámite procesado</p>
    </div>

    @if (tramite == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando detalles...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-bottom py-3">
                        <h5 class="fw-bold text-primary mb-0">
                            <i class="bi bi-info-circle me-2"></i>Información del Trámite
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label class="text-muted small">ID Trámite</label>
                                <p class="fw-bold">#TRX-@tramite.IdSolicitudTramite</p>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small">Tipo de Trámite</label>
                                <p class="fw-bold">@tramite.NombreTipoTramite</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label class="text-muted small">Fecha Solicitud</label>
                                <p class="fw-bold">@tramite.FechaSolicitud.ToShortDateString()</p>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small">Fecha Estimada</label>
                                <p class="fw-bold">@tramite.FechaEstimadaEntrega.ToShortDateString()</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Estado</label>
                            <div>
                                <span class="badge @GetEstadoBadgeClass(tramite.Estado)" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                    @tramite.Estado
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-bottom py-3">
                        <h5 class="fw-bold text-primary mb-0">
                            <i class="bi bi-person me-2"></i>Información del Rentista
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small">Nombre Completo</label>
                            <p class="fw-bold">@tramite.NombreRentista</p>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Funcionario Asignado</label>
                            <p class="fw-bold">@tramite.NombreFuncionarioAsignado</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <button class="btn btn-outline-secondary" @onclick="VolverAlHistorial">
                    <i class="bi bi-arrow-left me-2"></i>Volver al Historial
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long IdSolicitudTramite { get; set; }

    private SolicitudTramiteRegistroDTO? tramite;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramite = await TramiteService.ObtenerTramitePorIdAsync(IdSolicitudTramite);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void VolverAlHistorial()
    {
        NavigationManager.NavigateTo("/funcionario/historial-tramites");
    }

    private string GetEstadoBadgeClass(string estado)
    {
        if (estado == TramiteEstados.Completado.ToString()) return "bg-success";
        if (estado == TramiteEstados.Rechazado.ToString()) return "bg-danger";
        return "bg-secondary";
    }
}
