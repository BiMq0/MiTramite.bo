                        <div class="card-header bg-light border-bottom py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold text-primary mb-0">
                                    <i class="bi bi-eye me-2"></i>Visualización del Documento
                                </h5>
