    <!-- Botón Volver -->
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-4">
            <button class="btn btn-outline-secondary" @onclick="VolverAHistorial">
                <i class="bi bi-arrow-left me-2"></i>Volver al Historial
            </button>
        </div>
    </div>
</div>

