@page "/funcionario/historial-tramites/detalles/{IdSolicitudTramite:long}"
<!-- #region DATOS DE EJEMPLO TEMPORALES - CAMBIAR A MiTramite_Shared.DTOs.TramiteDTOs CUANDO ESTÉ DISPONIBLE -->
@using MiTramite_Front.Services.Tramite
<!-- #endregion -->
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject NavigationManager NavigationManager

<PageTitle>Detalles del Trámite</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="VolverAHistorial">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </button>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-file-earmark-text me-2"></i>Detalles del Trámite
        </h2>
        <p class="text-muted">Revisa la información completa y documentos del trámite procesado</p>
    </div>

    #region Datos de Ejemplo

    <div class="row">
        <!-- Información del Trámite -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-bottom py-3">
                    <h5 class="fw-bold text-primary mb-0">
                        <i class="bi bi-info-circle me-2"></i>Información del Trámite
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <label class="text-muted small">ID Trámite</label>
                            <p class="fw-bold">#TRX-2025-002</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small">Tipo de Trámite</label>
                            <p class="fw-bold">Afiliación</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <label class="text-muted small">Fecha Solicitud</label>
                            <p class="fw-bold">22/11/2025</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small">Fecha Conclusión</label>
                            <p class="fw-bold">29/11/2025</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Estado</label>
                        <div>
                            <span class="badge"
                                style="background-color: #5CB85C; color: white; font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                Completado
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-success">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Completado:</strong> Este trámite fue aprobado correctamente
                    </div>
                </div>
            </div>
        </div>

        <!-- Información del Rentista -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-bottom py-3">
                    <h5 class="fw-bold text-primary mb-0">
                        <i class="bi bi-person me-2"></i>Información del Rentista
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small">Nombre Completo</label>
                        <p class="fw-bold">María López García</p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <label class="text-muted small">Documento</label>
                            <p class="fw-bold">87654321</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small">Teléfono</label>
                            <p class="fw-bold">+591 75543210</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Email</label>
                        <p class="fw-bold">maria.lopez@email.com</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Dirección</label>
                        <p class="fw-bold">Avenida Arce 456, La Paz, Bolivia</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Archivos Subidos -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light border-bottom py-3">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-file-pdf me-2"></i>Documentos Subidos
            </h5>
        </div>
        <div class="card-body">
