@page "/funcionario/tramites-pendientes/revisar/{IdSolicitudTramite:long}"
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Domain.Constants
@inject Services.ITramiteService TramiteService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Revisar Trámite Pendiente</PageTitle>

<div class="container-fluid px-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
    <div class="mb-4 mt-3">
        <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="VolverATramitesPendientes">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </button>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-file-earmark-check me-2"></i>Revisar Trámite
        </h2>
        <p class="text-muted">Revisa los detalles y documentos del trámite</p>
    </div>

    @if (tramite == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando detalles del trámite...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-bottom py-3">
                        <h5 class="fw-bold text-primary mb-0">
                            <i class="bi bi-info-circle me-2"></i>Información del Trámite
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label class="text-muted small">ID Trámite</label>
                                <p class="fw-bold"># @tramite.IdSolicitudTramite</p>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small">Tipo de Trámite</label>
                                <p class="fw-bold">@tramite.NombreTipoTramite</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label class="text-muted small">Fecha Solicitud</label>
                                <p class="fw-bold">@tramite.FechaSolicitud.ToShortDateString()</p>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small">Fecha Estimada</label>
                                <p class="fw-bold">@tramite.FechaEstimadaEntrega.ToShortDateString()</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Estado</label>
                            <div>
                                <span class="badge @GetEstadoBadgeClass(tramite.Estado)"
                                    style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                    @tramite.Estado
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-bottom py-3">
                        <h5 class="fw-bold text-primary mb-0">
                            <i class="bi bi-person me-2"></i>Información del Rentista
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small">Nombre Completo</label>
                            <p class="fw-bold">@tramite.NombreCompletoRentista</p>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Funcionario Asignado</label>
                            <p class="fw-bold">@tramite.NombreCompletoFuncionarioAsignado</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light border-bottom py-3">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="bi bi-check-circle me-2"></i>Acción
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex gap-3">
                    <button class="btn btn-success" @onclick="AprobarTramite" disabled="@procesando">
                        <i class="bi bi-check-circle me-2"></i>@(procesando ? "Procesando..." : "Aprobar Trámite")
                    </button>
                    <button class="btn btn-danger" @onclick="MostrarModalRechazar" disabled="@procesando">
                        <i class="bi bi-x-circle me-2"></i>Rechazar Trámite
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="VolverATramitesPendientes">
                        <i class="bi bi-arrow-left me-2"></i>Volver
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger mt-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                    </div>
                }

                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle me-2"></i>@mensajeExito
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (mostrarModalRechazo)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rechazar Trámite</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalRechazar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="motivoRechazo" class="form-label">Motivo del Rechazo</label>
                        <textarea id="motivoRechazo" class="form-control" @bind="motivoRechazo" rows="4"></textarea>
                    </div>
                    <select id="accionParaRealizar" class="form-select" @bind="accionParaRealizar">
                        <option value="">Seleccione una acción</option>
                        <option value="Resubir documentos y realizar trámite nuevamente">Resubir documentos y realizar trámite nuevamente</option>
                        <option value="Apersonarse a las oficinas de la gestora">Apersonarse a las oficinas de la gestora</option>
                    </select>
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger">@errorModal</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalRechazar"
                        disabled="@procesando">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="RechazarTramiteConMotivo" disabled="@procesando">
                        @(procesando ? "Procesando..." : "Confirmar Rechazo")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long IdSolicitudTramite { get; set; }

    private SolicitudTramiteRegistroDTO? tramite;
    private bool mostrarModalRechazo = false;
    private string motivoRechazo = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private string errorModal = string.Empty;
    private bool procesando = false;
    private string accionParaRealizar = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramite = await TramiteService.ObtenerTramitePorIdAsync(IdSolicitudTramite);

            if (tramite == null)
            {
                mensajeError = "No se pudo cargar el trámite.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            mensajeError = "Error al cargar los detalles del trámite.";
        }
    }

    private void VolverATramitesPendientes()
    {
        NavigationManager.NavigateTo("/funcionario/tramites-pendientes");
    }

    private async Task AprobarTramite()
    {
        try
        {
            procesando = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
            StateHasChanged();

            var resultado = await TramiteService.CompletarTramiteAsync(IdSolicitudTramite);

            if (resultado)
            {
                mensajeExito = "Trámite aprobado exitosamente. Redirigiendo...";
                StateHasChanged();
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/funcionario/tramites-pendientes");
            }
            else
            {
                mensajeError = "No se pudo aprobar el trámite.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            mensajeError = "Error al aprobar el trámite.";
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private void MostrarModalRechazar()
    {
        mostrarModalRechazo = true;
        motivoRechazo = string.Empty;
        errorModal = string.Empty;
    }

    private void CerrarModalRechazar()
    {
        mostrarModalRechazo = false;
        motivoRechazo = string.Empty;
        errorModal = string.Empty;
    }

    private async Task RechazarTramiteConMotivo()
    {
        if (string.IsNullOrWhiteSpace(motivoRechazo))
        {
            errorModal = "El motivo del rechazo es requerido.";
            return;
        }

        try
        {
            procesando = true;
            errorModal = string.Empty;
            StateHasChanged();   

            var rechazoDto = new RechazoTramiteDTO
            {
                Motivo = motivoRechazo,
                AccionParaRealizar = accionParaRealizar
            };  

            var resultado = await TramiteService.RechazarTramiteAsync(IdSolicitudTramite, rechazoDto);

            if (resultado)
            {
                CerrarModalRechazar();
                mensajeExito = "Trámite rechazado exitosamente. Redirigiendo...";
                StateHasChanged();
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/funcionario/tramites-pendientes");
            }
            else
            {
                errorModal = "No se pudo rechazar el trámite.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            errorModal = "Error al rechazar el trámite.";
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private string GetEstadoBadgeClass(string estado)
    {
        if (estado == TramiteEstados.Pendiente.ToString()) return "bg-warning text-dark";
        if (estado == TramiteEstados.EnProceso.ToString()) return "bg-info text-dark";
        if (estado == TramiteEstados.Completado.ToString()) return "bg-success";
        if (estado == TramiteEstados.Rechazado.ToString()) return "bg-danger";
        return "bg-secondary";
    }
}