                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            No hay archivos subidos para este trámite
                        </div>
            }
            -->
        </div>
    </div>

    #endregion

    <!-- Vista Previa de PDF -->
    <!-- TODO: Mostrar iframe del PDF seleccionado
    @if (!string.IsNullOrEmpty(urlPdfVisualizando))
    {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-primary mb-0">
                                <i class="bi bi-eye me-2"></i>Visualización del Documento
                            </h5>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarVistaPrevia">
                                <i class="bi bi-x me-1"></i> Cerrar
