    <!-- Botones de Acción -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light border-bottom py-3">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-check-circle me-2"></i>Acción
            </h5>
        </div>
        <div class="card-body">
            <div class="d-flex gap-3">
                <button class="btn btn-success" @onclick="MostrarModalAprobar">
                    <i class="bi bi-check-circle me-2"></i>Aprobar Trámite
                </button>
                <button class="btn btn-danger" @onclick="MostrarModalRechazar">
                    <i class="bi bi-x-circle me-2"></i>Rechazar Trámite
                </button>
                <button class="btn btn-outline-secondary" @onclick="VolverATramitesPendientes">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </button>
            </div>
        </div>
    </div>
</div>

