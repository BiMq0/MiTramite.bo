@inject NavigationManager NavigationManager
@inject Handlers.AuthenticationStateService AuthenticationService
@implements IDisposable

@if (mostrarNavMenu)
{
    <nav class="sidebar">
        <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="nav flex-column">
                <div class="nav-item px-3">
                    @if (opcionesMenu.Count > 0)
                    {
                        @foreach (var opcion in opcionesMenu)
                        {
                            <NavLink class="nav-link" href="@opcion.Ruta" Match="NavLinkMatch.All">
                                <span class="nav-icon">
                                    <i class="bi @opcion.Icono"></i>
                                </span>
                                <span class="nav-text">@opcion.Label</span>
                            </NavLink>
                        }
                    }
                    else
                    {
                        <!-- Opciones por defecto si no hay opciones del servidor -->
                        <NavLink class="nav-link" href="/funcionario/inicio" Match="NavLinkMatch.All">
                            <span class="nav-icon">
                                <i class="bi bi-house"></i>
                            </span>
                            <span class="nav-text">Inicio</span>
                        </NavLink>
                        <NavLink class="nav-link" href="/funcionario/tramites">
                            <span class="nav-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>
                            <span class="nav-text">Trámites</span>
                        </NavLink>

                        <NavLink class="nav-link" href="/funcionario/control">
                            <span class="nav-icon">
                                <i class="bi bi-people"></i>
                            </span>
                            <span class="nav-text">Control de Funcionarios</span>
                        </NavLink>

                        <NavLink class="nav-link" href="/funcionario/reportes">
                            <span class="nav-icon">
                                <i class="bi bi-graph-up"></i>
                            </span>
                            <span class="nav-text">Reportes</span>
                        </NavLink>
                    }
                </div>
            </nav>
        </div>
    </nav>
}




@code {
    private bool mostrarNavMenu = false;
    private List<Handlers.MenuOpcion> opcionesMenu = new();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        AuthenticationService.OnLoginAsync += OnUserLogin;
        AuthenticationService.OnLogout += OnUserLogout;
        VerificarPagina();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            VerificarPagina();
            // Si ya hay un usuario autenticado, cargar sus opciones
            if (AuthenticationService.FuncionarioActual != null)
            {
                opcionesMenu = AuthenticationService.OpcionesMenuActuales;
                StateHasChanged();
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        VerificarPagina();
        StateHasChanged();
    }

    private async Task OnUserLogin(MiTramite_Shared.DTOs.FuncionarioDTOs.FuncionarioAccesosDTO funcionarioAccesos)
    {
        opcionesMenu = AuthenticationService.OpcionesMenuActuales;
        VerificarPagina();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void OnUserLogout()
    {
        opcionesMenu.Clear();
        mostrarNavMenu = false;
        StateHasChanged();
    }

    private void VerificarPagina()
    {
        var uri = NavigationManager.Uri;
        // Extraer solo la parte de la ruta sin el dominio
        var uriBuilder = new Uri(uri);
        var path = uriBuilder.AbsolutePath.ToLower();

        // No mostrar el NavMenu si está en login o en la raíz
        mostrarNavMenu = !path.Contains("login") && path != "/" && !string.IsNullOrEmpty(path);
    }

    void IDisposable.Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        AuthenticationService.OnLoginAsync -= OnUserLogin;
        AuthenticationService.OnLogout -= OnUserLogout;
    }
}