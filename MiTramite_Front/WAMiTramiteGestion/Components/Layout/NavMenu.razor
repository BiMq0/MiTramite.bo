@using MiTramite_Shared.DTOs.FuncionarioDTOs
@using WAMiTramiteGestion.Handlers
@inject NavigationManager NavigationManager
@inject Services.IFuncionarioService FuncionarioService
@rendermode InteractiveServer

@if (mostrarNavMenu)
{
    <div class="nav-scrollable">
        <nav class="nav flex-column">
            @if (opcionesMenu.Count > 0)
            {
                @foreach (var opcion in opcionesMenu)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@opcion.Ruta" Match="NavLinkMatch.All">
                            <i class="bi @opcion.Icono me-4 fs-6"></i> @opcion.Label
                        </NavLink>
                    </div>
                }
            }
            <div class="nav-item px-3 mt-5 pt-4 border-top">
                <button class="btn btn-outline-light w-100" @onclick="CerrarSesionAsync">
                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                </button>
            </div>
        </nav>
    </div>
}

@code {
    [Parameter]
    public string? Rol { get; set; }

    private bool mostrarNavMenu = false;
    private List<MenuOpcion> opcionesMenu = new();

    protected override void OnInitialized()
    {
        VerificarPagina();
        FiltrarOpcionesSegunRol(Rol);
    }

    protected override void OnParametersSet()
    {
        // Cuando cambia el parámetro Rol
        if (!string.IsNullOrEmpty(Rol))
        {
            FiltrarOpcionesSegunRol(Rol);
            StateHasChanged();
        }
    }

    private void VerificarPagina()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();

        // Mostrar NavMenu si está en gerente o funcionario, pero no en login ni en raíz
        if (uri.Contains("gerente") || uri.Contains("funcionario"))
        {
            mostrarNavMenu = true;
        }
        else
        {
            mostrarNavMenu = false;
        }
    }

    private void FiltrarOpcionesSegunRol(string? rol)
    {
        if (string.IsNullOrEmpty(rol))
        {
            opcionesMenu.Clear();
            return;
        }

        // Crear una lista nueva y filtrada según el rol
        var todasLasOpciones = new List<MenuOpcion>
{
new MenuOpcion{ Label="Inicio", Ruta="/gerente/inicio", Icono="bi-house" },
new MenuOpcion{ Label="Reportes", Ruta="/gerente/reportes", Icono="bi-bar-chart" },
new MenuOpcion{ Label="Gestión de Funcionarios", Ruta="/gerente/control-funcs", Icono="bi-people" },
new MenuOpcion{ Label="Gestión de Trámites", Ruta="/gerente/tramites", Icono="bi-folder2-open" },
new MenuOpcion{ Label="Incumplimientos", Ruta="/gerente/incumplimientos", Icono="bi-exclamation-triangle" },
new MenuOpcion{ Label="Inicio", Ruta="/funcionario/inicio", Icono="bi-house" },
new MenuOpcion{ Label="Trámites Pendientes", Ruta="/funcionario/tramites-pendientes", Icono="bi-clock" },
new MenuOpcion{ Label="Historial de Trámites", Ruta="/funcionario/historial-tramites", Icono="bi-folder2-open" },
};

        opcionesMenu = todasLasOpciones.Where(o => o.Ruta.Contains(rol.ToLower())).ToList();
    }

    private async Task CerrarSesionAsync()
    {
        await FuncionarioService.CerrarSesionAsync();
        NavigationManager.NavigateTo("/login", true);
    }
}