@using MiTramite_Shared.DTOs.FuncionarioDTOs
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Handlers.LoginStateService LoginStateService
@implements IDisposable

<Header />

<div class="page">
    <NavMenu Rol="@rolActual" />
    <main>
        <article class="content" style="padding: 0 !important;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>


<style>
    /* Layout container - distribuye header + contenido */
    body {
        margin: 0;
        padding: 0;
    }

    .main-content {
        flex: 1;
        background-color: #f5f7fb;
        overflow-y: auto;
    }

    .navbar {
        border-bottom: 3px solid rgba(255, 255, 255, 0.2);
    }

    #blazor-error-ui {
        background: #e11d48;
        color: white;
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 0.75rem;
        display: none;
        z-index: 1000;
        text-align: center;
    }

    #blazor-error-ui a.reload {
        color: #fff;
        text-decoration: underline;
        margin-left: 0.5rem;
    }

    #blazor-error-ui .dismiss {
        cursor: pointer;
        margin-left: 1rem;
    }
</style>

@code {
    private string? rolActual = null;

    protected override void OnInitialized()
    {
        LoginStateService.OnLoginSuccess += OnLoginSuccess;

        if (LoginStateService.EstaAutenticado && LoginStateService.UsuarioActual != null)
        {
            rolActual = LoginStateService.UsuarioActual.Rol;
        }
    }

    private void OnLoginSuccess(FuncionarioAccesosDTO usuario)
    {
        rolActual = usuario?.Rol;
        StateHasChanged();
    }

    void IDisposable.Dispose()
    {
        LoginStateService.OnLoginSuccess -= OnLoginSuccess;
    }
}