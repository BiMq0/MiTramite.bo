@inherits LayoutComponentBase

<!-- Navbar superior institucional -->
<header class="py-0">
    <nav class="navbar navbar-expand-lg shadow-sm w-100"
        style="background: linear-gradient(135deg, #1a365d, #2c5282, #3182ce);">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Logo y nombre -->
            <a class="navbar-brand d-flex align-items-center text-light" href="/">
                <div class="d-flex align-items-center">
                    <div class="me-3" style="width: 40px; height: 40px; background: linear-gradient(135deg, #1a365d, #3182ce, #63b3ed);
                                border-radius: 8px; display: flex; align-items: center; justify-content: center;
                                color: white; font-weight: bold; font-size: 1.2rem;">
                        MT
                    </div>
                    <div>
                        <div style="font-size: 1.25rem; font-weight: 700; line-height: 1;">Mi Trámite Gestión</div>
                        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.85); line-height: 1;">La Paz Digital
                        </div>
                    </div>
                    <div>
                        <img src="https://www.gestora.bo/img/logos/logoslogan.png" alt="Logo Gestora Nacional" style="height: 30px; margin-left: 10px; background: white;
                                    border-radius: 6px; padding: 4px 6px;" />
                    </div>
                </div>
            </a>
        </div>
    </nav>
</header>

<!-- Contenido principal -->
<main style="background-color: #f5f7fb; min-height: 100vh;">
    <article class="container-fluid p-0 " style="padding: 0 !important;">
        @Body
    </article>
</main>


<!-- Error Blazor -->
<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    /* Ajustes del layout */
    .navbar {
        border-bottom: 3px solid rgba(255, 255, 255, 0.2);
    }

    #blazor-error-ui {
        background: #e11d48;
        color: white;
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 0.75rem;
        display: none;
        z-index: 1000;
        text-align: center;
    }

    #blazor-error-ui a.reload {
        color: #fff;
        text-decoration: underline;
        margin-left: 0.5rem;
    }

    #blazor-error-ui .dismiss {
        cursor: pointer;
        margin-left: 1rem;
    }
</style>