@using WAMiTramite.Handlers
@using Microsoft.AspNetCore.Components
@inherits LayoutComponentBase

@if (mostrarNavMenu)
{
    <div class="d-flex vh-100 m-0 p-0">
        <NavMenu />

        <div class="flex-grow-1 d-flex flex-column">
            <header class="bg-white border-bottom px-4 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div>
                            <h4 class="mb-0" style="color: #1a365d;">MiTrámite</h4>
                            <small class="text-muted d-none d-md-inline">Gestión de trámites digitales</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="me-3 d-none d-md-block">
                            <small class="text-muted">Último acceso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-grow-1 p-4 bg-light overflow-auto main-content">
                @Body
            </main>
        </div>
    </div>

    <style>
        .main-content {
            padding: 1.5rem !important;
        }

        @@media (max-width: 991.98px) {
            .main-content {
                padding: 1rem !important;
            }
        }

        @@media (max-width: 576px) {
            .main-content {
                padding: 0.75rem !important;
            }
        }
    </style>
}
else
{
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <div class="d-flex align-items-center">
                        <div class="me-3"
                            style="width: 40px; height: 40px; background: linear-gradient(135deg, #1a365d, #3182ce, #63b3ed); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.2rem;">
                            MT
                        </div>
                        <div>
                            <div style="font-size: 1.25rem; font-weight: 700; color: white; line-height: 1;">MiTrámite</div>
                            <div style="font-size: 0.75rem; color: rgba(255,255,255,0.8); line-height: 1;">La Paz Digital
                            </div>
                        </div>
                        <div>
                            <img src="https://www.gestora.bo/img/logos/logoslogan.png" alt="Logo Gestora Nacional"
                                style="height: 30px; margin-left: 10px;" class="bg-white rounded m-2 px-2 py-1" />
                        </div>
                    </div>
                </a>
            </div>
        </nav>
    </header>

    <main>
        <article class="container-fluid p-0" style="padding: 0 !important;">
            @Body
        </article>
    </main>
}

<div id="blazor-error-ui" data-nosnippet>
    Un error inesperado ha ocurrido.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject]
    private NavigationManager? Navigation { get; set; }

    private bool mostrarNavMenu = false;

    protected override void OnInitialized()
    {
        mostrarNavMenu = !IsRoutaExcluida();
    }

    private bool IsRoutaExcluida()
    {
        if (Navigation == null) return true;

        string? uri = Navigation.Uri;
        if (string.IsNullOrEmpty(uri)) return true;

        string[] rutasExcluidas = new[] { "/", "/login", "/register" };

        foreach (var ruta in rutasExcluidas)
        {
            if (uri.EndsWith(ruta, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }
}