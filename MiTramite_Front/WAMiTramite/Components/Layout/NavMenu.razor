@* NavMenu - Solo sidebar sin wrapper de layout *@
@using Microsoft.AspNetCore.Components.Routing
@using WAMiTramite.Services
@using Services
@rendermode InteractiveServer

<div class="mobile-overlay @(sidebarOpen ? "show" : "")" @onclick="ToggleSidebar"></div>

<!-- Sidebar -->
<div class="sidebar text-white @(sidebarOpen ? "show" : "")"
    style="background: linear-gradient(135deg, #1a365d, #2c5282);">
    <div class="sidebar-header d-lg-none">
        <button class="btn btn-link text-white p-2" @onclick="ToggleSidebar">
            <i class="bi bi-x fs-4"></i>
        </button>
    </div>

    <div class="p-3">
        <!-- User Info -->
        <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-light border-opacity-25">
            <div class="me-3">
                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                    style="width: 50px; height: 50px;">
                    <i class="bi bi-person-fill text-white fs-4"></i>
                </div>
            </div>
            <div>
                <div class="fw-semibold">Usuario Demo</div>
                <small class="text-white-50">usuario@demo.com</small>
            </div>
        </div>

        <!-- Navigation Menu -->
        @if (RentistaStateStore.Current != null)
        {
            <nav class="nav flex-column">
                <NavLink class="nav-link text-white d-flex align-items-center py-3 px-3 border-0 bg-transparent"
                    href='@($"/dashboard/{RentistaStateStore.Current!.IdRentista}")' Match="NavLinkMatch.All"
                    @onclick="CloseSidebar">
                    <i class="bi bi-speedometer2 me-3 fs-5"></i>
                    <span>Dashboard</span>
                </NavLink>

                <NavLink class="nav-link text-white d-flex align-items-center py-3 px-3 border-0 bg-transparent"
                    href='@($"/nuevo-tramite/{RentistaStateStore.Current!.IdRentista}")' @onclick="CloseSidebar">
                    <i class="bi bi-file-earmark-plus me-3 fs-5"></i>
                    <span>Nuevo Trámite</span>
                </NavLink>

                <NavLink class="nav-link text-white d-flex align-items-center py-3 px-3 border-0 bg-transparent"
                    href='@($"/mis-tramites/{RentistaStateStore.Current!.IdRentista}")' @onclick="CloseSidebar">
                    <i class="bi bi-list-check me-3 fs-5"></i>
                    <span>Mis Trámites</span>
                </NavLink>

                <NavLink class="nav-link text-white d-flex align-items-center py-3 px-3 border-0 bg-transparent"
                    href='@($"/mis-documentos/{RentistaStateStore.Current!.IdRentista}")' @onclick="CloseSidebar">
                    <i class="bi bi-folder2-open me-3 fs-5"></i>
                    <span>Mis Documentos</span>
                </NavLink>
            </nav>
        }
    </div>

    <NavLink href="/">
        <div class="mt-auto p-3 border-top border-light border-opacity-25">
            <button class="btn btn-outline-light w-100">
                <i class="bi bi-box-arrow-right me-2"></i>
                Cerrar Sesión
            </button>
        </div>
    </NavLink>

</div>

<style>
    .sidebar {
        width: 280px;
        min-height: 100vh;
        transition: all 0.3s ease;
        position: relative;
        z-index: 1000;
    }

    .nav-link {
        border-radius: 0.5rem;
        margin-bottom: 0.25rem;
        transition: all 0.2s ease;
        position: relative;
    }

    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
        transform: translateX(3px);
    }

    .nav-link.active {
        background-color: rgba(255, 255, 255, 0.2) !important;
        font-weight: 600;
    }

    .mobile-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .sidebar-header {
        display: flex;
        justify-content: flex-end;
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Responsive styles */
    @@media (max-width: 991.98px) {
        .sidebar {
            position: fixed;
            top: 0;
            left: -280px;
            height: 100vh;
            z-index: 1000;
        }

        .sidebar.show {
            left: 0;
        }

        .mobile-overlay.show {
            display: block;
            opacity: 1;
        }
    }

    @@media (min-width: 992px) {
        .sidebar {
            position: relative;
            left: 0 !important;
        }

        .mobile-overlay {
            display: none !important;
        }

        .sidebar-header {
            display: none;
        }
    }
</style>

@code {
    [Inject]
    private NavigationManager? Navigation { get; set; }

    private bool sidebarOpen = false;

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
        StateHasChanged();
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
        StateHasChanged();
    }
}