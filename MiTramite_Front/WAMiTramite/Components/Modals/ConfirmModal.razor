@* Modal de confirmación reutilizable *@
@if (Visible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(Message))
                {
                    <p>@Message</p>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-primary" @onclick="OnCancelClicked">@CancelText</button>
                <button class="btn btn-primary" @onclick="OnConfirmClicked">@ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmar";
    [Parameter] public string Message { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Aceptar";
    [Parameter] public string CancelText { get; set; } = "Cancelar";

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task OnConfirmClicked()
    {
        if (OnConfirm.HasDelegate)
            await OnConfirm.InvokeAsync(null);
    }

    private async Task OnCancelClicked()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync(null);
    }
}