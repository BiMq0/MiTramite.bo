@page "/mis-tramites/{idRentista:int}"
@rendermode InteractiveServer
@using WAMiTramite.Components.Modals
@using WAMiTramite.Services
@inject IRentistaService RentistaService

<div class="container-fluid">
    <!-- Filtros y búsqueda -->
    <div class="row mb-4">
        <div class="col-md-8 col-12">
            <div class="input-group">
                <span class="input-group-text"
                    style="background-color: rgba(26, 54, 93, 0.1); border-color: #1a365d; color: #1a365d;">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Buscar por ID, tipo de trámite o funcionario..."
                    style="border-color: #1a365d;" @bind="filtroTexto" @oninput="FiltrarTramites">
            </div>
        </div>
        <div class="col-md-4 col-12">
            <select class="form-select" style="border-color: #1a365d;" @bind="filtroEstado"
                @bind:after="FiltrarTramites">
                <option value="">Todos los estados</option>
                <option value="En Proceso">En Proceso</option>
                <option value="Completado">Completado</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Rechazado">Rechazado</option>
                <option value="En Revisión">En Revisión</option>
            </select>
        </div>
    </div>

    <!-- Tabla de trámites -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0" style="color: #1a365d;">
                            <i class="bi bi-list-check me-2"></i>
                            Historial de Trámites (@tramitesFiltrados.Count)
                        </h6>
                        <button class="btn btn-sm text-white"
                            style="background: linear-gradient(135deg, #1a365d, #3182ce); border: none;"
                            @onclick="ActualizarTramites">
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            <span class="d-none d-sm-inline">Actualizar</span>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID Solicitud</th>
                                    <th scope="col">Tipo de Trámite</th>
                                    <th scope="col">Funcionario Asignado</th>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col">Reasignado</th>
                                    <th scope="col">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (tramitesFiltrados.Any())
                                {
                                    @foreach (var tramite in tramitesFiltrados)
                                    {
                                        <tr>
                                            <td>
                                                <code class="text-primary">@tramite.IdSolicitud</code>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@tramite.TipoTramite</div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-secondary bg-opacity-25 rounded-circle me-2 d-flex align-items-center justify-content-center"
                                                        style="width: 32px; height: 32px;">
                                                        <i class="bi bi-person text-secondary"></i>
                                                    </div>
                                                    <div>
                                                        <div class="small fw-semibold">@tramite.FuncionarioAsignado</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="small">@tramite.Fecha.ToString("dd/MM/yyyy")</div>
                                                <div class="small text-muted">@tramite.Fecha.ToString("HH:mm")</div>
                                            </td>
                                            <td>
                                                <span class="badge @GetEstadoBadgeClass(tramite.Estado)">
                                                    <i class="bi @GetEstadoIcon(tramite.Estado) me-1"></i>
                                                    @tramite.Estado
                                                </span>
                                            </td>
                                            <td>
                                                @if (tramite.Reasignado)
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-arrow-repeat me-1"></i>
                                                        Sí
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm text-white"
                                                        style="background: linear-gradient(135deg, #1a365d, #3182ce); border: none;"
                                                        @onclick="@(() => VerDetalle(tramite.IdSolicitud))" title="Ver detalle">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    @if (tramite.Estado == "Completado")
                                                    {
                                                        <button class="btn btn-sm text-white"
                                                            style="background: linear-gradient(135deg, #38a169, #48bb78); border: none;"
                                                            @onclick="@(() => DescargarResultado(tramite.IdSolicitud))"
                                                            title="Descargar resultado">
                                                            <i class="bi bi-download"></i>
                                                        </button>
                                                    }
                                                    @if (tramite.Estado == "Pendiente")
                                                    {
                                                        <button class="btn btn-sm text-white"
                                                            style="background: linear-gradient(135deg, #d69e2e, #f6e05e); border: none;"
                                                            @onclick="@(() => CompletarDocumentos(tramite.IdSolicitud))"
                                                            title="Completar documentos">
                                                            <i class="bi bi-file-earmark-plus"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox display-4 mb-3"></i>
                                            <div>No se encontraron trámites</div>
                                            <small>Los trámites aparecerán aquí una vez que los inicies</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<ConfirmModal
    Visible="@mostrarConfirmacion"
    Title="Confirmar acción"
    Message="@mensajeConfirmacion"
    ConfirmText="Aceptar"
    CancelText="Cancelar"
    OnConfirm="ConfirmarAccion"
    OnCancel="CancelarAccion" />

<OperationStatusModal
    Visible="@mostrarResultado"
    IsSuccess="@operacionExitosa"
    Title="@(operacionExitosa ? "¡Éxito!" : "Error")"
    Message="@mensajeResultado"
    OnClose="CerrarResultado" />

@code {
    [Parameter]
    public int IdRentista { get; set; }

    private string filtroTexto = string.Empty;
    private string filtroEstado = string.Empty;
    private List<TramiteViewModel> tramites = new();
    private List<TramiteViewModel> tramitesFiltrados = new();
    private bool mostrarConfirmacion = false;
    private bool mostrarResultado = false;
    private bool operacionExitosa = false;
    private string mensajeConfirmacion = string.Empty;
    private string mensajeResultado = string.Empty;
    private string accionActual = string.Empty;
    private string idSolicitudActual = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"MisTramites cargado para rentista: {IdRentista}");
        // TODO: En producción: tramites = await RentistaService.ObtenerTramites(IdRentista);
        CargarTramitesDemo();
        tramitesFiltrados = tramites;
    }

    private void CargarTramitesDemo()
    {
        tramites = new List<TramiteViewModel>
        {
            new() {
                IdSolicitud = "TR-2024-001",
                TipoTramite = "Afiliación de Trabajador Dependiente",
                FuncionarioAsignado = "María González Pérez",
                Fecha = DateTime.Now.AddDays(-5),
                Estado = "En Proceso",
                Reasignado = false
            },
            new() {
                IdSolicitud = "TR-2024-002",
                TipoTramite = "Acceso a Renta Dignidad",
                FuncionarioAsignado = "Carlos Mamani Quispe",
                Fecha = DateTime.Now.AddDays(-10),
                Estado = "Completado",
                Reasignado = true
            },
            new() {
                IdSolicitud = "TR-2024-003",
                TipoTramite = "Afiliación de Trabajador Dependiente",
                FuncionarioAsignado = "Ana Lucia Vargas",
                Fecha = DateTime.Now.AddDays(-15),
                Estado = "Pendiente",
                Reasignado = false
            },
            new() {
                IdSolicitud = "TR-2024-004",
                TipoTramite = "Acceso a Renta Dignidad",
                FuncionarioAsignado = "Jorge Luis Mendoza",
                Fecha = DateTime.Now.AddDays(-20),
                Estado = "En Revisión",
                Reasignado = false
            },
            new() {
                IdSolicitud = "TR-2024-005",
                TipoTramite = "Afiliación de Trabajador Dependiente",
                FuncionarioAsignado = "Patricia Condori Silva",
                Fecha = DateTime.Now.AddDays(-25),
                Estado = "Rechazado",
                Reasignado = true
            }
        };
    }

    private void FiltrarTramites()
    {
        tramitesFiltrados = tramites.Where(t =>
        (string.IsNullOrEmpty(filtroTexto) ||
        t.IdSolicitud.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
        t.TipoTramite.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
        t.FuncionarioAsignado.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(filtroEstado) || t.Estado == filtroEstado)
        ).ToList();

        StateHasChanged();
    }

    private string GetEstadoBadgeClass(string estado)
    {
        return estado switch
        {
            "Completado" => "badge-success",
            "En Proceso" => "badge-primary",
            "Pendiente" => "badge-warning",
            "En Revisión" => "badge-info",
            "Rechazado" => "badge-danger",
            _ => "bg-secondary"
        };
    }

    private string GetEstadoIcon(string estado)
    {
        return estado switch
        {
            "Completado" => "bi-check-circle-fill",
            "En Proceso" => "bi-clock-fill",
            "Pendiente" => "bi-exclamation-triangle-fill",
            "En Revisión" => "bi-eye-fill",
            "Rechazado" => "bi-x-circle-fill",
            _ => "bi-question-circle-fill"
        };
    }

    private void ActualizarTramites()
    {
        Console.WriteLine("Actualizando trámites...");
        CargarTramitesDemo();
        FiltrarTramites();
    }

    private void VerDetalle(string idSolicitud)
    {
        idSolicitudActual = idSolicitud;
        accionActual = "ver-detalle";
        mensajeConfirmacion = $"¿Deseas ver los detalles del trámite {idSolicitud}?";
        mostrarConfirmacion = true;
    }

    private void DescargarResultado(string idSolicitud)
    {
        idSolicitudActual = idSolicitud;
        accionActual = "descargar";
        mensajeConfirmacion = $"¿Deseas descargar el resultado del trámite {idSolicitud}?";
        mostrarConfirmacion = true;
    }

    private void CompletarDocumentos(string idSolicitud)
    {
        idSolicitudActual = idSolicitud;
        accionActual = "completar-docs";
        mensajeConfirmacion = $"¿Deseas completar documentos para el trámite {idSolicitud}?";
        mostrarConfirmacion = true;
    }

    private void CancelarAccion()
    {
        mostrarConfirmacion = false;
        accionActual = string.Empty;
        idSolicitudActual = string.Empty;
    }

    private async Task ConfirmarAccion()
    {
        mostrarConfirmacion = false;

        try
        {
            switch (accionActual)
            {
                case "ver-detalle":
                    operacionExitosa = true;
                    mensajeResultado = $"Abriendo detalles del trámite {idSolicitudActual}...";
                    break;
                case "descargar":
                    operacionExitosa = true;
                    mensajeResultado = $"Descargando resultado del trámite {idSolicitudActual}...";
                    break;
                case "completar-docs":
                    operacionExitosa = true;
                    mensajeResultado = $"Redirigiendo para completar documentos...";
                    break;
                default:
                    operacionExitosa = false;
                    mensajeResultado = "Acción no reconocida.";
                    break;
            }
            mostrarResultado = true;
        }
        catch (Exception ex)
        {
            operacionExitosa = false;
            mensajeResultado = $"Hubo un error: {ex.Message}";
            mostrarResultado = true;
        }

        accionActual = string.Empty;
        idSolicitudActual = string.Empty;
    }

    private void CerrarResultado()
    {
        mostrarResultado = false;
    }

    public class TramiteViewModel
    {
        public string IdSolicitud { get; set; } = string.Empty;
        public string TipoTramite { get; set; } = string.Empty;
        public string FuncionarioAsignado { get; set; } = string.Empty;
        public DateTime Fecha { get; set; }
        public string Estado { get; set; } = string.Empty;
        public bool Reasignado { get; set; }
    }
}

<style>
    .badge-success {
        background: linear-gradient(135deg, #38a169, #48bb78) !important;
        color: white;
    }

    .badge-primary {
        background: linear-gradient(135deg, #1a365d, #3182ce) !important;
        color: white;
    }

    .badge-warning {
        background: linear-gradient(135deg, #d69e2e, #f6e05e) !important;
        color: white;
    }

    .badge-info {
        background: linear-gradient(135deg, #3182ce, #63b3ed) !important;
        color: white;
    }

    .badge-danger {
        background: linear-gradient(135deg, #e53e3e, #fc8181) !important;
        color: white;
    }

    @@media (max-width: 768px) {

        .table th:nth-child(3),
        .table th:nth-child(4),
        .table th:nth-child(6),
        .table td:nth-child(3),
        .table td:nth-child(4),
        .table td:nth-child(6) {
            display: none;
        }
    }
</style>