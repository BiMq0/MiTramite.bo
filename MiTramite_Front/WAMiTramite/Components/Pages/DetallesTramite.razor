@page "/detalles-tramite/{idRentista:int}/{idTipoTramite:int}"
@rendermode InteractiveServer
@using WAMiTramite.Components.Modals
@using WAMiTramite.Services
@using MiTramite_Shared.DTOs.TipoTramiteDTOs
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Shared.DTOs.ArchivoDTOs
@inject NavigationManager Navigation
@inject IRentistaService RentistaService
@inject ITipoTramiteService TipoTramiteService
@inject ISolicitudTramiteService SolicitudTramiteService

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <a href="/nuevo-tramite/@IdRentista" class="btn btn-outline-primary btn-sm mb-3">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>

            @if (tramite != null)
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-file-earmark-text me-2"></i>
                            @tramite.Nombre
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-8">
                                <p class="text-muted">@tramite.Descripcion</p>
                                <div class="row">
                                    <div class="col-md-6">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            Tiempo estimado: @tramite.DiasDuracionEstimada días
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <h6 class="mb-3">Archivos Requeridos</h6>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Por favor, sube los documentos requeridos para este trámite.
                        </div>

                        <div class="card mb-3">
                            <div class="card-body p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-file-pdf text-danger fs-5 me-2"></i>
                                            <div>
                                                <div class="fw-semibold">Documentos de Respaldo</div>
                                                <small class="text-muted">Máximo: 5 MB | Formato: PDF</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <InputFile OnChange="CargarArchivo" class="form-control form-control-sm"
                                            accept=".pdf" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (archivosSubidos.Any())
                        {
                            <div class="mt-3">
                                <h6>Archivos seleccionados:</h6>
                                <ul class="list-group">
                                    @foreach (var archivo in archivosSubidos)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @archivo.Nombre
                                            <span class="badge bg-primary rounded-pill">@FormatFileSize(archivo.Peso)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="mt-4">
                            <button class="btn btn-primary" @onclick="EnviarDocumentos"
                                disabled="@(!archivosSubidos.Any())">
                                <i class="bi bi-cloud-upload me-2"></i>
                                Enviar Solicitud
                            </button>
                            <a href="/nuevo-tramite/@IdRentista" class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancelar
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modals -->
<ConfirmModal Visible="@mostrarConfirmacion" Title="Confirmar envío"
    Message="¿Está seguro que desea enviar la solicitud? Una vez enviada no podrá modificarla." ConfirmText="Enviar"
    CancelText="Cancelar" OnConfirm="ConfirmarEnvio" OnCancel="CancelarEnvio" />

<OperationStatusModal Visible="@mostrarResultado" IsSuccess="@operacionExitosa"
    Title="@(operacionExitosa ? "¡Éxito!" : "Error")" Message="@mensajeResultado" OnClose="CerrarResultado" />

@code {
    [Parameter]
    public int IdRentista { get; set; }

    [Parameter]
    public int IdTipoTramite { get; set; }

    private TipoTramiteDTO? tramite;
    private List<ArchivoNuevoDTO> archivosSubidos = new();
    private bool mostrarConfirmacion = false;
    private bool mostrarResultado = false;
    private bool operacionExitosa = false;
    private string mensajeResultado = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramite = await TipoTramiteService.ObtenerTramitePorId(IdTipoTramite);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar trámite: {ex.Message}");
        }
    }

    private async Task CargarArchivo(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.ContentType != "application/pdf")
            {
                mensajeResultado = "Solo se permiten archivos PDF.";
                operacionExitosa = false;
                mostrarResultado = true;
                return;
            }

            const long maxSize = 5 * 1024 * 1024;
            if (file.Size > maxSize)
            {
                mensajeResultado = "El archivo no puede superar 5 MB.";
                operacionExitosa = false;
                mostrarResultado = true;
                return;
            }

            try
            {
                using var stream = new MemoryStream();
                await file.OpenReadStream(maxSize).CopyToAsync(stream);

                var nuevoArchivo = new ArchivoNuevoDTO
                {
                    IdRentista = IdRentista,
                    Nombre = file.Name,
                    Peso = (int)(file.Size / 1024.0 / 1024.0),
                    Contenido = stream.ToArray()
                };

                archivosSubidos.Add(nuevoArchivo);
            }
            catch (Exception ex)
            {
                mensajeResultado = $"Error al leer el archivo: {ex.Message}";
                operacionExitosa = false;
                mostrarResultado = true;
            }
        }
    }

    private string FormatFileSize(double bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        while (bytes >= 1024 && order < sizes.Length - 1)
        {
            order++;
            bytes = bytes / 1024;
        }
        return $"{bytes:0.##} {sizes[order]}";
    }

    private void EnviarDocumentos()
    {
        mostrarConfirmacion = true;
    }

    private void CancelarEnvio()
    {
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarEnvio()
    {
        mostrarConfirmacion = false;

        try
        {
            var solicitud = new SolicitudTramiteNuevoDTO
            {
                IdRentista = IdRentista,
                IdTipoTramite = IdTipoTramite,
            };

            var resultado = await SolicitudTramiteService.CrearSolicitud(solicitud);

            if (resultado)
            {
                operacionExitosa = true;
                mensajeResultado = "La solicitud ha sido enviada correctamente.";
                mostrarResultado = true;

                await Task.Delay(2000);
                Navigation.NavigateTo($"/mis-tramites");
            }
            else
            {
                operacionExitosa = false;
                mensajeResultado = "No se pudo enviar la solicitud. Inténtalo de nuevo.";
                mostrarResultado = true;
            }
        }
        catch (Exception ex)
        {
            operacionExitosa = false;
            mensajeResultado = $"Hubo un error al enviar la solicitud: {ex.Message}";
            mostrarResultado = true;
        }
    }

    private void CerrarResultado()
    {
        mostrarResultado = false;
    }
}