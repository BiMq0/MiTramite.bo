@page "/detalles-tramite/{idRentista:int}/{idTipoTramite:int}"
@rendermode InteractiveServer
@using WAMiTramite.Components.Modals
@using WAMiTramite.Services
@using MiTramite_Shared.DTOs.TipoTramiteDTOs
@using MiTramite_Shared.DTOs.SolicitudTramiteDTOs
@using MiTramite_Shared.DTOs.ArchivoDTOs
@using MiTramite_Shared.DTOs.ArchivosRequeridosTramite
@inject NavigationManager Navigation
@inject IRentistaService RentistaService
@inject ITipoTramiteService TipoTramiteService
@inject ISolicitudTramiteService SolicitudTramiteService
@inject IArchivoService ArchivoService

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <a href="/nuevo-tramite/@IdRentista" class="btn btn-outline-primary btn-sm mb-3">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>

            @if (tramite != null)
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-file-earmark-text me-2"></i>
                            @tramite.Nombre
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-8">
                                <p class="text-muted">@tramite.Descripcion</p>
                                <div class="row">
                                    <div class="col-md-6">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            Tiempo estimado: @tramite.DiasDuracionEstimada días
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <h6 class="mb-3">Archivos Requeridos</h6>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Por favor, sube los documentos requeridos para este trámite.
                        </div>

                        @if (cargandoArchivos)
                        {
                            <div class="text-center my-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando archivos...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (archivosFaltantes.Any())
                            {
                                <div class="mb-4">
                                    <h6 class="text-danger mb-3">
                                        <i class="bi bi-exclamation-circle me-2"></i>
                                        Documentos Faltantes
                                    </h6>
                                    @foreach (var archivoFaltante in archivosFaltantes)
                                    {
                                        <DocumentoFaltante TipoArchivo="archivoFaltante" 
                                                          IdRentista="IdRentista" 
                                                          OnArchivoSubido="CargarArchivos" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mb-4">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Todos los documentos requeridos han sido subidos.
                                </div>
                            }
                        }

                        <div class="mt-4">
                            <button class="btn btn-primary" @onclick="EnviarDocumentos"
                                disabled="@(archivosFaltantes.Any() || cargandoArchivos)">
                                <i class="bi bi-cloud-upload me-2"></i>
                                Enviar Solicitud
                            </button>
                            <a href="/nuevo-tramite/@IdRentista" class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancelar
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<ConfirmModal Visible="@mostrarConfirmacion" Title="Confirmar envío"
    Message="¿Está seguro que desea enviar la solicitud? Una vez enviada no podrá modificarla." ConfirmText="Enviar"
    CancelText="Cancelar" OnConfirm="ConfirmarEnvio" OnCancel="CancelarEnvio" />

<OperationStatusModal Visible="@mostrarResultado" IsSuccess="@operacionExitosa"
    Title="@(operacionExitosa ? "¡Éxito!" : "Error")" Message="@mensajeResultado" OnClose="CerrarResultado" />

@code {
    [Parameter]
    public int IdRentista { get; set; }

    [Parameter]
    public int IdTipoTramite { get; set; }

    private TipoTramiteDTO? tramite;
    private List<ArchivosRequeridosTramiteDTO> archivosRequeridos = new();
    private List<ArchivoRegistroDTO> archivosRentista = new();
    private List<ArchivosRequeridosTramiteDTO> archivosFaltantes = new();
    private bool cargandoArchivos = true;
    
    private bool mostrarConfirmacion = false;
    private bool mostrarResultado = false;
    private bool operacionExitosa = false;
    private string mensajeResultado = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramite = await TipoTramiteService.ObtenerTramitePorId(IdTipoTramite);
            await CargarArchivos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar trámite: {ex.Message}");
        }
    }

    private async Task CargarArchivos()
    {
        cargandoArchivos = true;
        try
        {
            archivosRequeridos = await ArchivoService.ObtenerArchivosRequeridos(IdTipoTramite);
            archivosRentista = await ArchivoService.ObtenerArchivosDelRentista(IdRentista);

            archivosFaltantes = archivosRequeridos
                .Where(req => !archivosRentista.Any(exist => exist.IdTipoArchivo == req.IdTipoArchivo))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando archivos: {ex.Message}");
        }
        finally
        {
            cargandoArchivos = false;
        }
    }

    private void EnviarDocumentos()
    {
        mostrarConfirmacion = true;
    }

    private void CancelarEnvio()
    {
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarEnvio()
    {
        mostrarConfirmacion = false;

        try
        {
            var solicitud = new SolicitudTramiteNuevoDTO
            {
                IdRentista = IdRentista,
                IdTipoTramite = IdTipoTramite,
            };

            var resultado = await SolicitudTramiteService.CrearSolicitud(solicitud);

            if (resultado)
            {
                operacionExitosa = true;
                mensajeResultado = "La solicitud ha sido enviada correctamente.";
                mostrarResultado = true;

                await Task.Delay(2000);
                Navigation.NavigateTo($"/mis-tramites/{IdRentista}");
            }
            else
            {
                operacionExitosa = false;
                mensajeResultado = "No se pudo enviar la solicitud. Inténtalo de nuevo.";
                mostrarResultado = true;
            }
        }
        catch (Exception ex)
        {
            operacionExitosa = false;
            mensajeResultado = $"Hubo un error al enviar la solicitud: {ex.Message}";
            mostrarResultado = true;
        }
    }

    private void CerrarResultado()
    {
        mostrarResultado = false;
    }
}