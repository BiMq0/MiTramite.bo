@page "/mis-documentos/{idRentista:int}"
@rendermode InteractiveServer
@using WAMiTramite.Components.Modals
@using WAMiTramite.Services
@using MiTramite_Shared.DTOs.ArchivoDTOs
@using MiTramite_Shared.DTOs.TipoArchivoDTOs
@inject IJSRuntime JSRuntime
@inject IArchivoService ArchivoService
@inject ITipoArchivoService TipoArchivoService

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0 text-primary">
                        <i class="bi bi-cloud-upload me-2"></i>
                        Subir Nuevos Documentos
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tipo de Documento</th>
                                    <th>Requisitos</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (tiposDisponibles != null && tiposDisponibles.Any())
                                {
                                    @foreach (var tipo in tiposDisponibles)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@tipo.Nombre</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info text-dark">Max @tipo.PesoMaximoMB MB</span>
                                                <span class="badge bg-secondary">PDF</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <InputFile OnChange="@(e => SubirArchivo(e, tipo))"
                                                        class="form-control form-control-sm" accept=".pdf"
                                                        style="max-width: 250px;" />
                                                    @if (subiendoArchivoId == tipo.IdTipoArchivo)
                                                    {
                                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                            <span class="visually-hidden">Subiendo...</span>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">
                                            Cargando tipos de documentos...
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Tabla de documentos subidos -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="bi bi-folder2-open me-2"></i>
                            Mis Documentos Guardados (@(documentosSubidos?.Count ?? 0))
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="CargarDatos">
                            <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Documento</th>
                                    <th scope="col">Detalles</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (documentosSubidos != null && documentosSubidos.Any())
                                {
                                    @foreach (var documento in documentosSubidos)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-file-earmark-pdf text-danger fs-4 me-3"></i>
                                                    <div>
                                                        <div class="fw-bold">@documento.Nombre</div>
                                                        <small
                                                            class="text-muted">@ObtenerNombreTipo(documento.IdTipoArchivo)</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span
                                                    class="badge bg-light text-dark border">@FormatFileSize(documento.Peso)</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    <a href="@ObtenerUrlDescarga(documento)" download="@documento.Nombre"
                                                        class="btn btn-sm btn-outline-primary" title="Descargar">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="@(() => ConfirmarEliminarDocumento(documento.IdArchivo))"
                                                        title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox display-4 mb-3 d-block"></i>
                                            No tienes documentos guardados aún.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<ConfirmModal Visible="@mostrarConfirmacionEliminar" Title="Confirmar eliminación"
    Message="¿Está seguro que desea eliminar este documento? Esta acción no se puede deshacer." ConfirmText="Eliminar"
    CancelText="Cancelar" OnConfirm="EjecutarEliminacion" OnCancel="CancelarEliminar" />

<OperationStatusModal Visible="@mostrarResultado" IsSuccess="@operacionExitosa"
    Title="@(operacionExitosa ? "¡Éxito!" : "Error")" Message="@mensajeResultado" OnClose="CerrarResultado" />

@code {
    [Parameter]
    public int IdRentista { get; set; }

    private List<ArchivoRegistroDTO> documentosSubidos = new();
    private List<TipoArchivoParaSubirDTO> tiposDisponibles = new();

    private bool mostrarConfirmacionEliminar = false;
    private bool mostrarResultado = false;
    private bool operacionExitosa = false;
    private string mensajeResultado = string.Empty;
    private long documentoAEliminar = 0;
    private int subiendoArchivoId = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            var taskTipos = TipoArchivoService.OBtenerTiposDeDocumentoParaSubir();
            var taskDocumentos = ArchivoService.ObtenerArchivosDelRentista(IdRentista);

            await Task.WhenAll(taskTipos, taskDocumentos);

            tiposDisponibles = await taskTipos;
            documentosSubidos = await taskDocumentos;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando datos: {ex.Message}");
        }
    }

    private async Task SubirArchivo(InputFileChangeEventArgs e, TipoArchivoParaSubirDTO tipo)
    {
        var file = e.File;
        if (file == null) return;

        // Validar tamaño (MB a Bytes)
        long maxBytes = tipo.PesoMaximoMB * 1024 * 1024;
        if (file.Size > maxBytes)
        {
            operacionExitosa = false;
            mensajeResultado = $"El archivo excede el tamaño máximo de {tipo.PesoMaximoMB} MB.";
            mostrarResultado = true;
            return;
        }

        // Validar tipo (solo PDF por ahora según requerimiento)
        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            operacionExitosa = false;
            mensajeResultado = "Solo se permiten archivos PDF.";
            mostrarResultado = true;
            return;
        }

        subiendoArchivoId = tipo.IdTipoArchivo;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var contenido = ms.ToArray();

            var archivoNuevo = new ArchivoNuevoDTO
            {
                IdRentista = IdRentista,
                IdTipoArchivo = tipo.IdTipoArchivo,
                Nombre = file.Name,
                Peso = (int)file.Size,
                Contenido = contenido
            };

            var resultado = await ArchivoService.SubirArchivo(archivoNuevo);

            if (resultado)
            {
                operacionExitosa = true;
                mensajeResultado = "Documento subido correctamente.";
                await CargarDatos(); // Recargar lista
            }
            else
            {
                operacionExitosa = false;
                mensajeResultado = "Error al subir el documento. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            operacionExitosa = false;
            mensajeResultado = $"Error: {ex.Message}";
        }
        finally
        {
            subiendoArchivoId = 0;
            mostrarResultado = true;
            StateHasChanged();
        }
    }

    private string ObtenerNombreTipo(int idTipo)
    {
        var tipo = tiposDisponibles.FirstOrDefault(t => t.IdTipoArchivo == idTipo);
        return tipo?.Nombre ?? "Desconocido";
    }

    private string ObtenerUrlDescarga(ArchivoRegistroDTO documento)
    {
        if (documento.Contenido == null || documento.Contenido.Length == 0) return "#";
        var base64 = Convert.ToBase64String(documento.Contenido);
        return $"data:application/pdf;base64,{base64}";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private void ConfirmarEliminarDocumento(long documentoId)
    {
        documentoAEliminar = documentoId;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacionEliminar = false;
        documentoAEliminar = 0;
    }

    private async Task EjecutarEliminacion()
    {
        mostrarConfirmacionEliminar = false;

        try
        {
            var resultado = await ArchivoService.EliminarArchivo(documentoAEliminar);

            if (resultado)
            {
                operacionExitosa = true;
                mensajeResultado = "Documento eliminado correctamente.";
                await CargarDatos();
            }
            else
            {
                operacionExitosa = false;
                mensajeResultado = "No se pudo eliminar el documento.";
            }
        }
        catch (Exception ex)
        {
            operacionExitosa = false;
            mensajeResultado = $"Error: {ex.Message}";
        }
        finally
        {
            mostrarResultado = true;
            documentoAEliminar = 0;
            StateHasChanged();
        }
    }

    private void CerrarResultado()
    {
        mostrarResultado = false;
    }
}

<style>
    /* Estilos responsivos */
    @@media (max-width: 768px) {
        .btn-group {
            display: flex;
        }

        .table th,
        .table td {
            padding: 0.5rem;
            font-size: 0.9rem;
        }
    }
</style>