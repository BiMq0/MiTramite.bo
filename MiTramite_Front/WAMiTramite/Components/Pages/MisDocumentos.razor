@page "/mis-documentos/{idRentista:int}"
@rendermode InteractiveServer
@using WAMiTramite.Components.Modals
@using WAMiTramite.Services
@inject IJSRuntime JSRuntime
@inject IRentistaService RentistaService

<div class="container-fluid">
    <div class="row">
        <!-- Tabla de documentos -->
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="bi bi-folder2-open me-2"></i>
                            Mis Documentos (@documentos.Count)
                        </h6>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm text-white"
                                style="background: linear-gradient(135deg, #38a169, #48bb78); border: none;"
                                @onclick="SubirDocumento">
                                <i class="bi bi-cloud-upload me-1"></i>
                                <span class="d-none d-sm-inline">Subir Documento</span>
                                <span class="d-sm-none">Subir</span>
                            </button>
                            <button class="btn btn-sm text-white"
                                style="background: linear-gradient(135deg, #1a365d, #3182ce); border: none;"
                                @onclick="ActualizarDocumentos">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                <span class="d-none d-sm-inline">Actualizar</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Tipo de Documento</th>
                                    <th scope="col">Nombre del Archivo</th>
                                    <th scope="col">Fecha de Subida</th>
                                    <th scope="col">Tamaño</th>
                                    <th scope="col">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (documentos.Any())
                                {
                                    @foreach (var documento in documentos)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i
                                                        class="bi @GetDocumentIcon(documento.TipoDocumento) me-2 text-primary fs-5"></i>
                                                    <div>
                                                        <div class="fw-semibold">@documento.TipoDocumento</div>
                                                        <small class="text-muted">@documento.Descripcion</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="small">
                                                    <div class="fw-semibold">@documento.NombreArchivo</div>
                                                    <small class="text-muted">@documento.Extension.ToUpper()</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="small">@documento.FechaSubida.ToString("dd/MM/yyyy")</div>
                                                <div class="small text-muted">@documento.FechaSubida.ToString("HH:mm")</div>
                                            </td>
                                            <td>
                                                <small class="text-muted">@FormatFileSize(documento.Tamano)</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm text-white"
                                                        style="background: linear-gradient(135deg, #1a365d, #3182ce); border: none;"
                                                        @onclick="@(() => AbrirDocumentoEnNuevaPestaña(documento))"
                                                        title="Ver documento">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button class="btn btn-sm text-white"
                                                        style="background: linear-gradient(135deg, #38a169, #48bb78); border: none;"
                                                        @onclick="@(() => DescargarDocumento(documento.Id))" title="Descargar">
                                                        <i class="bi bi-download"></i>
                                                    </button>
                                                    <button class="btn btn-sm text-white"
                                                        style="background: linear-gradient(135deg, #e53e3e, #fc8181); border: none;"
                                                        @onclick="@(() => ConfirmarEliminarDocumento(documento.Id))" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="bi bi-cloud-upload display-4 mb-3"></i>
                                            <div>No hay documentos subidos</div>
                                            <small>Los documentos que subas aparecerán aquí</small>
                                            <div class="mt-3">
                                                <button class="btn btn-sm text-white"
                                                    style="background: linear-gradient(135deg, #1a365d, #3182ce); border: none;"
                                                    @onclick="SubirDocumento">
                                                    <i class="bi bi-cloud-upload me-1"></i>
                                                    Subir primer documento
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<ConfirmModal
    Visible="@mostrarConfirmacionEliminar"
    Title="Confirmar eliminación"
    Message="¿Está seguro que desea eliminar este documento? Esta acción no se puede deshacer."
    ConfirmText="Eliminar"
    CancelText="Cancelar"
    OnConfirm="ConfirmarEliminar"
    OnCancel="CancelarEliminar" />

<OperationStatusModal
    Visible="@mostrarResultado"
    IsSuccess="@operacionExitosa"
    Title="@(operacionExitosa ? "¡Éxito!" : "Error")"
    Message="@mensajeResultado"
    OnClose="CerrarResultado" />

@code {
    [Parameter]
    public int IdRentista { get; set; }

    private List<DocumentoViewModel> documentos = new();
    private bool mostrarConfirmacionEliminar = false;
    private bool mostrarResultado = false;
    private bool operacionExitosa = false;
    private string mensajeResultado = string.Empty;
    private int documentoAEliminar = 0;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"MisDocumentos cargado para rentista: {IdRentista}");
        // TODO: En producción: documentos = (await RentistaService.ObtenerDocumentos(IdRentista))?.Select(...).ToList();
        CargarDocumentosDemo();
    }

    private void CargarDocumentosDemo()
    {
        documentos = new List<DocumentoViewModel>
        {
            new() {
                Id = 1,
                TipoDocumento = "Cédula de Identidad",
                Descripcion = "Documento de identificación personal",
                NombreArchivo = "cedula_juan_perez.pdf",
                Extension = ".pdf",
                FechaSubida = DateTime.Now.AddDays(-10),
                Tamano = 2048576,
                UrlArchivo = "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf"
            },
            new() {
                Id = 2,
                TipoDocumento = "Certificado de Nacimiento",
                Descripcion = "Certificado oficial de nacimiento",
                NombreArchivo = "certificado_nacimiento.jpg",
                Extension = ".jpg",
                FechaSubida = DateTime.Now.AddDays(-5),
                Tamano = 1536000,
                UrlArchivo = "https://via.placeholder.com/800x600/007bff/ffffff?text=Certificado+de+Nacimiento"
            },
            new() {
                Id = 3,
                TipoDocumento = "Contrato de Trabajo",
                Descripcion = "Contrato laboral vigente",
                NombreArchivo = "contrato_trabajo_2024.pdf",
                Extension = ".pdf",
                FechaSubida = DateTime.Now.AddDays(-3),
                Tamano = 1024000,
                UrlArchivo = "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf"
            },
            new() {
                Id = 4,
                TipoDocumento = "Comprobante de Domicilio",
                Descripcion = "Factura de servicios básicos",
                NombreArchivo = "factura_luz_noviembre.docx",
                Extension = ".docx",
                FechaSubida = DateTime.Now.AddDays(-1),
                Tamano = 512000,
                UrlArchivo = ""
            }
        };
    }

    private string GetDocumentIcon(string tipoDocumento)
    {
        return tipoDocumento.ToLower() switch
        {
            var t when t.Contains("cedula") => "bi-card-text",
            var t when t.Contains("certificado") => "bi-award",
            var t when t.Contains("contrato") => "bi-file-earmark-text",
            var t when t.Contains("comprobante") => "bi-receipt",
            var t when t.Contains("factura") => "bi-receipt",
            _ => "bi-file-earmark"
        };
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task AbrirDocumentoEnNuevaPestaña(DocumentoViewModel documento)
    {
        if (!string.IsNullOrWhiteSpace(documento.UrlArchivo))
        {
            await JSRuntime.InvokeVoidAsync("open", documento.UrlArchivo, "_blank");
        }
        else
        {
            DescargarDocumento(documento.Id);
        }
    }

    private void SubirDocumento()
    {
        Console.WriteLine("Abrir modal de subida de documentos");
    }

    private void ActualizarDocumentos()
    {
        Console.WriteLine("Actualizando documentos...");
        CargarDocumentosDemo();
        StateHasChanged();
    }

    private void DescargarDocumento(int documentoId)
    {
        Console.WriteLine($"Descargar documento ID: {documentoId}");
    }

    private void ConfirmarEliminarDocumento(int documentoId)
    {
        documentoAEliminar = documentoId;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacionEliminar = false;
        documentoAEliminar = 0;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirmacionEliminar = false;

        try
        {
            // En producción: await RentistaService.EliminarDocumento(idRentista, documentoAEliminar);
            
            documentos.RemoveAll(d => d.Id == documentoAEliminar);
            operacionExitosa = true;
            mensajeResultado = "Documento eliminado correctamente.";
            mostrarResultado = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            operacionExitosa = false;
            mensajeResultado = $"Hubo un error al eliminar el documento: {ex.Message}";
            mostrarResultado = true;
        }

        documentoAEliminar = 0;
    }

    private void CerrarResultado()
    {
        mostrarResultado = false;
    }

    public class DocumentoViewModel
    {
        public int Id { get; set; }
        public string TipoDocumento { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public string NombreArchivo { get; set; } = string.Empty;
        public string Extension { get; set; } = string.Empty;
        public DateTime FechaSubida { get; set; }
        public long Tamano { get; set; }
        public string UrlArchivo { get; set; } = string.Empty;
    }
}

<style>
    @@media (max-width: 768px) {
        .d-flex.gap-2 {
            flex-direction: column;
            gap: 0.5rem !important;
        }

        .btn-sm {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }

        .table-responsive {
            font-size: 0.875rem;
        }

        .card-header h6 {
            font-size: 0.9rem;
        }

        .btn-group {
            flex-direction: column;
            width: 100%;
        }

        .btn-group .btn {
            border-radius: 0.25rem !important;
            margin-bottom: 0.25rem;
        }
    }

    @@media (max-width: 576px) {
        .container-fluid {
            padding: 0.5rem;
        }

        .card-header {
            padding: 0.75rem;
        }

        .card-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .card-header .d-flex>div:last-child {
            margin-top: 0.5rem;
            width: 100%;
        }

        .table th,
        .table td {
            padding: 0.5rem 0.25rem;
            font-size: 0.8rem;
        }

        .table th:nth-child(3),
        .table th:nth-child(4),
        .table td:nth-child(3),
        .table td:nth-child(4) {
            display: none;
        }

        .fw-semibold {
            font-size: 0.85rem;
        }

        .small {
            font-size: 0.75rem !important;
        }
    }
</style>