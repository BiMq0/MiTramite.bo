@page "/"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<link href="/css/gestora-theme.css" rel="stylesheet" />

<section class="hero ">
    <div class="container d-flex flex-column flex-lg-row align-items-center">
        <div class="col-lg-6">
            <h1 class="display-4 fw-bold">Modernizamos los trámites de La Paz</h1>
            <p class="lead muted-small">Una plataforma centrada en la ciudadanía para gestionar trámites municipales de
                forma fácil, transparente y segura.</p>

            <div class="d-flex hero-cta mt-4 gap-2">
                <button class="btn btn-primary btn-lg" @onclick="@(() => NavigateToRegister())">Crear cuenta</button>
                <button class="btn btn-primary btn-lg" @onclick="@(() => NavigateToLogin())">Iniciar
                    sesión</button>
            </div>

            <div class="mt-4 text-small">
                <small>Servicios: pagos en línea, seguimiento de trámites, notificaciones y soporte presencial.</small>
            </div>
        </div>

        <div class="col-lg-6 text-center mt-4 mt-lg-0">
            <img src="/images/hero-illustration.svg" class="img-fluid hero-illus"
                alt="Ilustración de trámites digitales" />
        </div>
    </div>
</section>

<section class="features">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <h5>Trámites en línea</h5>
                    <p class="muted-small">Realiza solicitudes y pagos desde cualquier dispositivo sin desplazarte.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <h5>Transparencia</h5>
                    <p class="muted-small">Historial y estado de cada trámite con trazabilidad completa.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <h5>Atención ciudadana</h5>
                    <p class="muted-small">Soporte multicanal y guías paso a paso para cada servicio.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="how">
    <div class="container">
        <h3 class="section-title">Cómo funciona</h3>
        <div class="row gy-4">
            <div class="col-md-4">
                <div class="how-step">
                    <div class="badge">1</div>
                    <div>
                        <h6>Regístrate</h6>
                        <p class="muted-small">Crea una cuenta rápida con tu correo o credenciales institucionales.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="how-step">
                    <div class="badge">2</div>
                    <div>
                        <h6>Elige el trámite</h6>
                        <p class="muted-small">Selecciona el servicio y completa el formulario en línea.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="how-step">
                    <div class="badge">3</div>
                    <div>
                        <h6>Recibe seguimiento</h6>
                        <p class="muted-small">Notificaciones y seguimiento en tiempo real hasta la resolución.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="faq">
    <div class="container">
        <h3 class="section-title">Preguntas frecuentes</h3>
        <div class="accordion" id="faqAcc">
            <div class="accordion-item">
                <h2 class="accordion-header" id="q1">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapse1">¿Cómo verifico el estado de mi trámite?</button>
                </h2>
                <div id="collapse1" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body muted-small">Ingresa a tu cuenta y ve a la sección "Mis trámites" para
                        ver el estado actualizado.</div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="q2">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapse2">¿Puedo pagar en línea?</button>
                </h2>
                <div id="collapse2" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body muted-small">Sí, la plataforma acepta pagos con tarjeta y métodos
                        nacionales compatibles.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="contact-cta d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                <h4 class="mb-1">Listo para modernizar tus trámites?</h4>
                <p class="muted-small mb-0">Crea una cuenta y comienza ahora. La plataforma está pensada para la ciudad
                    de La Paz.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <button class="btn btn-light btn-lg" @onclick="@(() => NavigateToRegister())">Crear cuenta</button>
                <button class="btn btn-outline-light btn-lg ms-2" @onclick="@(() => NavigateToLogin())">Iniciar
                    sesión</button>
            </div>
        </div>
    </div>
</section>

<!-- Contact form simple -->
<section class="py-5 bg-light">
    <div class="container">
        <h3 class="section-title text-white">Contáctanos</h3>
        <p class="muted-small text-white">¿Tienes alguna duda o sugerencia? Envíanos un mensaje rápido.</p>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Nombre</label>
                <input class="form-control" @bind="contactModel.Nombre" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="contactModel.Email" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Asunto</label>
                <input class="form-control" @bind="contactModel.Asunto" />
            </div>

            <div class="col-12 mt-3">
                <button type="button" class="btn btn-primary" @onclick="HandleSubmit">Enviar mensaje</button>
            </div>

            <div class="col-12 mt-3">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                else if (sent)
                {
                    <div class="alert alert-success">Gracias, tu mensaje ha sido enviado. Nos contactaremos pronto.</div>
                }
            </div>
        </div>
    </div>
</section>


<!-- Footer inspirado en sitios gubernamentales -->
<footer style="background: linear-gradient(135deg, #1a365d, #2c5282); color: white; padding: 2rem 0; margin-top: 3rem;">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3"
                        style="width: 40px; height: 40px; background: linear-gradient(135deg, #1a365d, #3182ce, #63b3ed); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.2rem;">
                        MT
                    </div>
                    <div>
                        <div style="font-size: 1.1rem; font-weight: 600;">MiTrámite La Paz</div>
                        <div style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">Gobierno Digital Transparente
                        </div>
                    </div>
                </div>
                <p style="color: rgba(255,255,255,0.9); font-size: 0.9rem;">
                    Plataforma oficial del Gobierno Autónomo Municipal de La Paz para la gestión digital de trámites
                    ciudadanos.
                </p>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="mb-3">
                    <h6 style="color: white; margin-bottom: 1rem;">Enlaces útiles</h6>
                    <div class="d-flex flex-column" style="gap: 0.5rem;">
                        <a href="#" style="color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem;">
                            Soporte técnico</a>
                        <a href="#" style="color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem;">
                            Preguntas frecuentes</a>
                        <a href="#" style="color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem;">
                            Guías de trámites</a>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border-color: rgba(255,255,255,0.2); margin: 1.5rem 0;">
        <div class="text-center" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">
            © 2024 Gobierno Autónomo Municipal de La Paz. Todos los derechos reservados.
        </div>
    </div>
</footer>


@code {
    private void NavigateToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    // Contact form model and handler
    private ContactModel contactModel = new ContactModel();
    private bool sent = false;
    private string? errorMessage;

    private void HandleSubmit()
    {
        errorMessage = null;
        sent = false;

        if (string.IsNullOrWhiteSpace(contactModel.Nombre))
        {
            errorMessage = "El nombre es requerido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(contactModel.Email) || !contactModel.Email.Contains("@"))
        {
            errorMessage = "Proporcione un email válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(contactModel.Asunto))
        {
            errorMessage = "El asunto es requerido.";
            return;
        }

        // Aquí podrías llamar a un servicio para enviar el mensaje.
        sent = true;
        // Reset form after send
        contactModel = new ContactModel();
    }

    public class ContactModel
    {
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Asunto { get; set; } = string.Empty;
    }
}