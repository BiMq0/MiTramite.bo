@using WAMiTramite.Services
@using MiTramite_Shared.DTOs.TipoTramiteDTOs
@inject NavigationManager Navigation

<div class="card h-100 shadow-sm hover-card" style="cursor: pointer;">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center"
                style="width: 80px; height: 80px;">
                <i class="@GetTramiteIcon() text-primary" style="font-size: 2rem;"></i>
            </div>
        </div>

        <h5 class="card-title text-center mb-2">@Tramite?.Nombre</h5>

        <div class="text-center mb-3">
            <span class="badge bg-success">
                <i class="bi bi-star-fill me-1"></i>
                Disponible
            </span>
        </div>

        <p class="card-text text-muted small text-center mb-4">
            @Tramite?.Descripcion
        </p>

        <div class="d-grid">
            <button class="btn btn-primary" type="button" @onclick="IniciarTramite">
                <i class="bi bi-arrow-right-circle me-2"></i>
                Iniciar Trámite
            </button>
        </div>

        <div class="mt-3 p-3 bg-light rounded">
            <h6 class="small mb-2" style="color: #1a365d;">
                <i class="bi bi-info-circle me-1"></i>
                Información:
            </h6>
            <ul class="small mb-0 text-muted">
                <li>Tiempo estimado: @Tramite?.DiasDuracionEstimada días</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
    }
</style>

@code {
    [Parameter]
    public TipoTramiteDTO? Tramite { get; set; }

    [Parameter]
    public EventCallback<int> OnIniciarTramite { get; set; }

    private string GetTramiteIcon()
    {
        return Tramite?.Nombre?.ToLower() switch
        {
            var n when n?.Contains("afiliación") == true => "bi bi-person-badge",
            var n when n?.Contains("renta") == true => "bi bi-cash-coin",
            var n when n?.Contains("licencia") == true => "bi bi-building",
            var n when n?.Contains("permiso") == true => "bi bi-house",
            var n when n?.Contains("certificado") == true => "bi bi-file-earmark-text",
            _ => "bi bi-file-earmark-plus"
        };
    }

    private async Task IniciarTramite()
    {
        if (Tramite?.IdTipoTramite > 0)
        {
            await OnIniciarTramite.InvokeAsync(Tramite.IdTipoTramite);
        }
    }
}
